rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.role == 'admin';
    }
    
    function isOwnerNew() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    function isPredictorOwner(predictorId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/predictors/$(predictorId));
    }
    
    function getMatch(tournamentId, matchId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
    }
    
    function isMatchOpen(matchData) {
      return matchData.status != 'finished' && 
             matchData.status != 'live' &&
             matchData.status != 'postponed' &&
             matchData.status != 'cancelled';
    }
    
    function isDeadlineNotPassed(matchData) {
      return matchData.predictionDeadline == null || 
             request.time < matchData.predictionDeadline;
    }
    
    function isBeforeTournamentStart() {
      return request.time < timestamp.date(2026, 6, 11);
    }
    
    function canPredictOnMatch(tournamentId, matchId) {
      let matchData = getMatch(tournamentId, matchId);
      return isMatchOpen(matchData) && isDeadlineNotPassed(matchData);
    }
    
    // Users - read own profile, admin reads all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
      
      // Predictors - user manages their own predictors
      match /predictors/{predictorId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
        
        // Predictor stats - read own, Cloud Functions write
        match /stats/{tournamentId} {
          allow read: if request.auth.uid == userId || isAdmin();
          allow write: if false; // Only Cloud Functions can write
        }
      }
      
      // Notifications
      match /notifications/{notificationId} {
        allow read: if request.auth.uid == userId;
        allow write: if false; // Only Cloud Functions can write
      }
      
      // FCM tokens - owner can read and write their own tokens
      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Tournaments - public read, admin write
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Groups
      match /groups/{groupId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      // Teams
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      // Matches - public read, admin write
      match /matches/{matchId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      // Bets - predictor owns their bets.
      // INTENTIONAL: reads are open to any authenticated user. Bets power the
      // social rankings ("today's bets", leaderboard) features, so participants
      // can see each other's predictions. This is a product decision, not a leak.
      match /bets/{betId} {
        allow read: if request.auth != null;
        allow create: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId) &&
          canPredictOnMatch(tournamentId, request.resource.data.matchId) &&
          request.resource.data.homeScore is int &&
          request.resource.data.homeScore >= 0 &&
          request.resource.data.homeScore <= 15 &&
          request.resource.data.awayScore is int &&
          request.resource.data.awayScore >= 0 &&
          request.resource.data.awayScore <= 15;
        // Editable until the match starts; client-side prediction-service.ts
        // skips finished/live/postponed/cancelled/deadline-passed matches at
        // submit time. Ownership checks mirror create.
        allow update: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId) &&
          request.resource.data.homeScore is int &&
          request.resource.data.homeScore >= 0 &&
          request.resource.data.homeScore <= 15 &&
          request.resource.data.awayScore is int &&
          request.resource.data.awayScore >= 0 &&
          request.resource.data.awayScore <= 15;
        allow delete: if isAdmin();
      }
      
      // Group bets — reads intentionally open to any authed user (social rankings).
      match /group_bets/{betId} {
        allow read: if request.auth != null;
        allow create: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId);
        // Editable until the group starts; the client enforces "group started"
        // (any match live/finished). Ownership checks mirror create.
        allow update: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId);
        allow delete: if isAdmin();
      }
      
      // Knockout bets — reads intentionally open to any authed user (social rankings).
      match /knockout_bets/{betId} {
        allow read: if request.auth != null;
        allow create: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId) &&
          canPredictOnMatch(tournamentId, request.resource.data.matchId) &&
          request.resource.data.predictedWinner != null &&
          request.resource.data.predictedWinner != '';
        // Editable until the match's prediction deadline (canPredictOnMatch).
        allow update: if
          isOwnerNew() &&
          isPredictorOwner(request.resource.data.predictorId) &&
          canPredictOnMatch(tournamentId, request.resource.data.matchId) &&
          request.resource.data.predictedWinner != null &&
          request.resource.data.predictedWinner != '';
        allow delete: if isAdmin();
      }
      
      // Group standings - read only, Cloud Functions write
      match /group_standings/{standingId} {
        allow read: if true;
        allow write: if false;
      }
      
      // Final phase bets - predictor owns their bet with deadline enforcement
      match /final_phase_bets/{predictorId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && 
          request.auth.uid == request.resource.data.userId &&
          isBeforeTournamentStart();
        allow delete: if isAdmin();
      }
      
      // Best players bets - predictor owns their bet with deadline enforcement
      match /best_players_bets/{predictorId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && 
          request.auth.uid == request.resource.data.userId &&
          isBeforeTournamentStart();
        allow delete: if isAdmin();
      }
    }
  }
}
