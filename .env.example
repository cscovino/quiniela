# Firebase Configuration
# Get these values from Firebase Console → Project Settings → General → Your apps
PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Cloud Messaging (FCM) - Required for PWA push notifications
# Get the VAPID public key from Firebase Console → Cloud Messaging → Web configuration
# Never expose the private key - it stays on Firebase's servers
VITE_FIREBASE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
