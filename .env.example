# Firebase Configuration
# Get these values from Firebase Console → Project Settings → General → Your apps
PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Cloud Messaging (FCM) - Required for PWA push notifications
# Get the VAPID public key from Firebase Console → Cloud Messaging → Web configuration
# Never expose the private key - it stays on Firebase's servers
VITE_FIREBASE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Firebase App Check (reCAPTCHA v3) - Required for API endpoint protection
# Get your reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin/create
# Register it in Firebase Console → Security → App Check → Web apps
PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# Tournament Configuration
# The Firestore document ID for the active tournament.
# Changing this (+ rebuild) points the app at a different tournament.
PUBLIC_TOURNAMENT_ID=world-cup-2026

# Firebase App Check Debug Token — DEV only; PROD ignores this var entirely
# Without it the app emits a console.warn and App Check tokens will not be generated,
# causing /api/rankings to return 401 in development.
# Two ways to get the UUID:
#   (a) Run pnpm dev, open DevTools Console, copy the UUID from "App Check debug token: <uuid>"
#   (b) Firebase Console → Build → App Check → Apps → ⋮ → Manage debug tokens → Add debug token
# Register the UUID in Firebase Console → App Check → Manage debug tokens, then paste it here.
# This file is gitignored — the UUID is a dev credential, never commit it.
PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
