{
  "name": "quiniela",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-matrix-json.mjs && astro build",
    "build:functions": "cd functions && pnpm run build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:app": "pnpm build && pnpm firebase:hosting",
    "firebase:hosting": "firebase deploy --only hosting",
    "firebase:functions": "firebase deploy --only functions",
    "firebase:firestore": "firebase deploy --only firestore",
    "test": "vitest",
    "test:run": "vitest run --project unit --project storybook --project functions --passWithNoTests",
    "test:functions": "vitest run --project functions --no-color 2>&1 | grep -v 'No test files' || true",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm exec vitest run --project rules\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" --fix",
    "lint:functions": "eslint \"functions/src/**/*.{js,ts}\"",
    "lint:functions:fix": "eslint \"functions/src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro,css,json}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "seed": "tsx --env-file=.env scripts/seed-tournament.ts",
    "fix-badges": "tsx --env-file=.env scripts/fix-badges.ts",
    "fix-badges:dry-run": "tsx --env-file=.env scripts/fix-badges.ts --dry-run",
    "set-admin": "tsx --env-file=.env scripts/set-admin-role.ts",
    "sync-displayname": "tsx --env-file=.env scripts/sync-user-displayname.ts",
    "migrate:knockout": "tsx --env-file=.env scripts/migrate-knockout-schedule.ts",
    "migrate:knockout:phase2": "tsx --env-file=.env scripts/migrate-knockout-schedule.ts --phase2",
    "migrate:avatars": "tsx --env-file=.env scripts/migrate-predictor-avatars.ts",
    "migrate:avatars:apply": "tsx --env-file=.env scripts/migrate-predictor-avatars.ts --apply",
    "migrate:case": "tsx --env-file=.env scripts/migrate-team-ids-case.ts",
    "migrate:case:execute": "tsx --env-file=.env scripts/migrate-team-ids-case.ts --execute",
    "migrate:rescore": "tsx --env-file=.env scripts/rescore-group-bets.ts",
    "migrate:rescore:execute": "tsx --env-file=.env scripts/rescore-group-bets.ts --execute",
    "migrate:totals": "tsx --env-file=.env scripts/recompute-predictor-totals.ts",
    "migrate:totals:execute": "tsx --env-file=.env scripts/recompute-predictor-totals.ts --execute",
    "migrate:group-reset": "tsx --env-file=.env scripts/reset-incomplete-group-scoring.ts",
    "migrate:group-reset:execute": "tsx --env-file=.env scripts/reset-incomplete-group-scoring.ts --execute",
    "migrate:schedule": "tsx --env-file=.env scripts/migrate-match-schedule.ts",
    "migrate:schedule:execute": "tsx --env-file=.env scripts/migrate-match-schedule.ts --execute",
    "migrate:classified": "tsx --env-file=.env scripts/backfill-classified-team-ids.ts",
    "migrate:classified:execute": "tsx --env-file=.env scripts/backfill-classified-team-ids.ts --execute",
    "migrate:classified:audit": "tsx --env-file=.env scripts/backfill-classified-team-ids.ts --audit",
    "migrate:classified:execute:tournament": "tsx --env-file=.env scripts/backfill-classified-team-ids.ts --execute --tournament",
    "audit:completion": "tsx --env-file=.env scripts/audit-predictor-completion.ts",
    "audit:completion:csv": "tsx --env-file=.env scripts/audit-predictor-completion.ts --csv",
    "predictors:deleted": "tsx --env-file=.env scripts/fetch-soft-deleted-predictors.ts",
    "predictors:deleted:csv": "tsx --env-file=.env scripts/fetch-soft-deleted-predictors.ts --csv",
    "set:best-player-bet": "tsx --env-file=.env scripts/set-best-player-bet.ts --",
    "verify:group-bets": "tsx --env-file=.env scripts/verify-group-bets.ts --",
    "audit:group-scoring": "tsx --env-file=.env scripts/audit-group-scoring.ts",
    "fix:group-scoring": "tsx --env-file=.env scripts/fix-group-scoring.ts",
    "set:predictor-predictions": "tsx --env-file=.env scripts/set-predictor-predictions.ts --",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write",
      "pnpm test:run"
    ],
    "functions/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "pnpm test:functions"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@dicebear/core": "9.4.2",
    "@dicebear/pixel-art": "9.4.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.4",
    "driver.js": "^1.4.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "flag-icons": "^7.5.0",
    "pixelarticons": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "storybook": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "uuid": ">=11.1.1"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "minimumReleaseAge": {
      "firebase-tools": "0"
    }
  }
}
