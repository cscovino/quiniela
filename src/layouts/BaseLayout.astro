---
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { NavBar } from '@organisms/NavBar/NavBar';
import { PWAInstall } from '@organisms/PWAInstall/PWAInstall';
import { ToastProvider } from '@organisms/ToastProvider/ToastProvider';
import {
  getNavLinks,
  getAdminLink,
  getTranslations,
  getOtherLocale,
  getDateLocale,
  getOgLocale,
  type ActiveNav,
} from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
  title: string;
  description?: string;
  theme?: 'dark' | 'light';
  activeNav?: ActiveNav;
  notificationCount?: number;
  image?: string;
  type?: 'website' | 'article' | 'sports-event';
}

const {
  locale,
  title,
  description,
  theme = 'dark',
  activeNav = 'home',
  notificationCount = 0,
  image = '/icons/icon-512x512.png',
  type = 'website',
} = Astro.props;

const siteUrl = 'https://quiniela.app';
const canonicalUrl = Astro.url.pathname;
const fullUrl = `${siteUrl}${canonicalUrl}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const navLinks = getNavLinks(locale, activeNav);
const adminLink = getAdminLink(locale, activeNav);
const tNav = getTranslations(locale).common.nav;
const tCommon = getTranslations(locale).common.common;
const tTournament = getTranslations(locale).common.tournament;
const pwaTranslations = getTranslations(locale).common.pwa;
const navBarTranslations = {
  brandLabel: tNav.brandLabel,
  login: tCommon.login,
  logout: tCommon.logout,
  makePredictions: tCommon.makePredictions,
  switchLocale: tNav.switchLocale,
  toggleTheme: tNav.toggleTheme,
  toggleMenu: tNav.toggleMenu,
  notifications: tNav.notifications,
  tournamentName: tTournament.name,
};

const otherLocale = getOtherLocale(locale);
const alternateUrl = canonicalUrl.replace(`/${locale}`, `/${otherLocale}`);
---

<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00bfff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Quiniela" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={fullUrl} />
    <link rel="alternate" hreflang={locale} href={fullUrl} />
    <link rel="alternate" hreflang={otherLocale} href={`${siteUrl}${alternateUrl}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <link rel="preload" href="/fonts/PressStart2P.woff2" as="font" type="font/woff2" crossorigin />

    <!-- DNS Preconnect for Firebase -->
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://firebase.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fcm.googleapis.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title.replace(/ - Quiniela$/, '')} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:locale" content={getOgLocale(locale)} />
    <meta property="og:site_name" content="Quiniela" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title.replace(/ - Quiniela$/, '')} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': type === 'sports-event' ? 'SportsEvent' : 'WebSite',
        name: title.replace(/ - Quiniela$/, ''),
        description:
          description || `Retro pixel art football predictions for ${tTournament.fullName}`,
        url: fullUrl,
        image: ogImage,
        inLanguage: getDateLocale(locale),
        ...(type === 'sports-event'
          ? {
              startDate: '2026-06-11',
              endDate: '2026-07-19',
              location: {
                '@type': 'Place',
                name: tTournament.fullName,
                address: {
                  '@type': 'PostalAddress',
                  addressCountry: ['CA', 'MX', 'US'],
                },
              },
            }
          : {}),
        publisher: {
          '@type': 'Organization',
          name: 'Quiniela',
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/icons/icon-192x192.png`,
          },
        },
      })}
    />
  </head>
  <body>
    <NavBar
      links={navLinks}
      adminLink={adminLink}
      locale={locale}
      notificationCount={notificationCount}
      translations={navBarTranslations}
      client:load
    />
    <main transition:name="content" transition:animate="fade">
      <slot />
    </main>
    <ToastProvider client:idle />
    <PWAInstall translations={pwaTranslations} client:load />
    <script src="../scripts/runtime.ts"></script>
  </body>
</html>
