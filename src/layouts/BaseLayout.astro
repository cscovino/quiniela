---
import '@styles/global.css';
import NavBar from '@organisms/NavBar/NavBar.astro';
import { ToastProvider } from '@organisms/ToastProvider/ToastProvider';
import type { NavLinks } from '@organisms/NavBar/NavBar';

export interface Props {
  locale: 'en' | 'es';
  title: string;
  description?: string;
  theme?: 'dark' | 'light';
  activeNav?: 'home' | 'predictions' | 'rankings' | 'profile' | 'tournament' | 'admin';
  notificationCount?: number;
}

const {
  locale,
  title,
  description,
  theme = 'dark',
  activeNav = 'home',
  notificationCount = 0,
} = Astro.props;

const navLinks: NavLinks[] =
  locale === 'en'
    ? [
        { href: '/en', label: 'Home', active: activeNav === 'home' },
        { href: '/en/tournament', label: 'Tournament', active: activeNav === 'tournament' },
        { href: '/en/predictions', label: 'Predictions', active: activeNav === 'predictions' },
        { href: '/en/rankings', label: 'Rankings', active: activeNav === 'rankings' },
        { href: '/en/profile', label: 'Profile', active: activeNav === 'profile' },
      ]
    : [
        { href: '/', label: 'Inicio', active: activeNav === 'home' },
        { href: '/torneo', label: 'Torneo', active: activeNav === 'tournament' },
        { href: '/predicciones', label: 'Predicciones', active: activeNav === 'predictions' },
        { href: '/clasificacion', label: 'Clasificación', active: activeNav === 'rankings' },
        { href: '/perfil', label: 'Perfil', active: activeNav === 'profile' },
      ];
---

<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://firestore.googleapis.com wss://*.firebaseio.com;"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href="/fonts/PressStart2P.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <NavBar links={navLinks} locale={locale} notificationCount={notificationCount} />
    <slot />
    <ToastProvider client:load />
    <script>
      const html = document.documentElement;
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        html.setAttribute('data-theme', savedTheme);
      }
    </script>
  </body>
</html>
