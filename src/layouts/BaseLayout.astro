---
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import NavBar from '@organisms/NavBar/NavBar.astro';
import { ToastProvider } from '@organisms/ToastProvider/ToastProvider';

interface NavLinks {
  href: string;
  label: string;
  active: boolean;
}

export interface Props {
  locale: 'en' | 'es';
  title: string;
  description?: string;
  theme?: 'dark' | 'light';
  activeNav?: 'home' | 'predictions' | 'rankings' | 'profile' | 'tournament' | 'admin';
  notificationCount?: number;
  image?: string;
  type?: 'website' | 'article' | 'sports-event';
}

const {
  locale,
  title,
  description,
  theme = 'dark',
  activeNav = 'home',
  notificationCount = 0,
  image = '/icons/icon-512x512.png',
  type = 'website',
} = Astro.props;

const siteUrl = 'https://quiniela.app';
const canonicalUrl = Astro.url.pathname;
const fullUrl = `${siteUrl}${canonicalUrl}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const navLinks: NavLinks[] =
  locale === 'en'
    ? [
        { href: '/en', label: 'Home', active: activeNav === 'home' },
        { href: '/en/tournament', label: 'Tournament', active: activeNav === 'tournament' },
        { href: '/en/predictions', label: 'Predictions', active: activeNav === 'predictions' },
        { href: '/en/rankings', label: 'Rankings', active: activeNav === 'rankings' },
        { href: '/en/profile', label: 'Profile', active: activeNav === 'profile' },
      ]
    : [
        { href: '/', label: 'Inicio', active: activeNav === 'home' },
        { href: '/torneo', label: 'Torneo', active: activeNav === 'tournament' },
        { href: '/predicciones', label: 'Predicciones', active: activeNav === 'predictions' },
        { href: '/clasificacion', label: 'Clasificación', active: activeNav === 'rankings' },
        { href: '/perfil', label: 'Perfil', active: activeNav === 'profile' },
      ];

const alternateUrl = locale === 'en' ? '/' : '/en' + canonicalUrl;
---

<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00bfff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Quiniela" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={fullUrl} />
    <link rel="alternate" hreflang={locale} href={fullUrl} />
    <link
      rel="alternate"
      hreflang={locale === 'en' ? 'es' : 'en'}
      href={`${siteUrl}${alternateUrl}`}
    />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <link rel="preload" href="/fonts/PressStart2P.woff2" as="font" type="font/woff2" crossorigin />

    <!-- DNS Preconnect for Firebase -->
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://firebase.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fcm.googleapis.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title.replace(/ - Quiniela$/, '')} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="Quiniela" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title.replace(/ - Quiniela$/, '')} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': type === 'sports-event' ? 'SportsEvent' : 'WebSite',
        name: title.replace(/ - Quiniela$/, ''),
        description: description || 'Retro pixel art football predictions for FIFA World Cup 2026',
        url: fullUrl,
        image: ogImage,
        inLanguage: locale === 'en' ? 'en-US' : 'es-ES',
        ...(type === 'sports-event'
          ? {
              startDate: '2026-06-11',
              endDate: '2026-07-19',
              location: {
                '@type': 'Place',
                name: 'FIFA World Cup 2026',
                address: {
                  '@type': 'PostalAddress',
                  addressCountry: ['CA', 'MX', 'US'],
                },
              },
            }
          : {}),
        publisher: {
          '@type': 'Organization',
          name: 'Quiniela',
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/icons/icon-192x192.png`,
          },
        },
      })}
    />
  </head>
  <body>
    <NavBar links={navLinks} locale={locale} notificationCount={notificationCount} />
    <main transition:name="content" transition:animate="fade">
      <slot />
    </main>
    <ToastProvider client:idle />
    <script src="../scripts/runtime.ts"></script>
  </body>
</html>
