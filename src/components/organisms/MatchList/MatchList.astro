---
import MatchCard from '@molecules/MatchCard/MatchCard.astro';
import type { MatchCardData } from '@molecules/MatchCard/types';

export interface Props {
  matches: MatchCardData[];
  title?: string;
  emptyMessage?: string;
  translations: {
    scheduled: string;
    live: string;
    finished: string;
    postponed: string;
    cancelled: string;
    vs: string;
  };
  locale?: 'en' | 'es';
  className?: string;
}

const {
  matches = [],
  title,
  emptyMessage = 'No matches available',
  translations,
  locale = 'en',
  className = '',
} = Astro.props;
---

<div class={`match-list ${matches.length === 0 ? 'match-list--empty' : ''} ${className}`}>
  {title && <h3 class="match-list__title">{title}</h3>}
  {
    matches.length === 0 ? (
      <p class="match-list__empty">{emptyMessage}</p>
    ) : (
      <div class="match-list__items">
        {matches.map((match) => (
          <MatchCard
            homeTeam={match.homeTeam}
            awayTeam={match.awayTeam}
            date={match.date}
            status={match.status}
            result={match.result}
            stadium={match.stadium}
            phase={match.phase}
            translations={translations}
            locale={locale}
          />
        ))}
      </div>
    )
  }
</div>

<style>
  .match-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .match-list--empty {
    align-items: center;
    justify-content: center;
    padding: var(--space-12);
    text-align: center;
    color: var(--text-muted);
  }

  .match-list__title {
    font-family: var(--font-heading);
    font-size: var(--heading-sm);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .match-list__empty {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .match-list__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
