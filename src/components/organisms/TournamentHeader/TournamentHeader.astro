---
export interface Props {
  name: string;
  startDate: Date;
  endDate: Date;
  participantCount?: number;
  className?: string;
  translations: {
    teams: string;
  };
}

const { name, startDate, endDate, participantCount, className = '', translations } = Astro.props;

const formattedDates = `${startDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} - ${endDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
---

<div class={`tournament-header ${className}`}>
  <div class="tournament-header__title">
    <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M12 2C9.24 2 7 4.24 7 7h2c0-1.66 1.34-3 3-3s3 1.34 3 3h2c0-2.76-2.24-5-5-5zM5 7H2v5c0 1.66 1.34 3 3 3h.17C5.64 16.27 6.73 17.23 8 17.63V20H6v2h12v-2h-2v-2.37c1.27-.4 2.36-1.36 2.83-2.63H19c1.66 0 3-1.34 3-3V7h-3V5h-3V7H8V5H5v2zm12 5c0 .55-.45 1-1 1h-1V9h2v3zM5 9h2v4H6c-.55 0-1-.45-1-1V9z"
      ></path>
    </svg>
    <h1>{name}</h1>
  </div>

  <div class="tournament-header__meta">
    <div class="tournament-header__dates">
      <svg
        class="icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{formattedDates}</span>
    </div>

    {
      participantCount !== undefined && (
        <div class="tournament-header__participants">
          <svg
            class="icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>
            {participantCount} {translations.teams}
          </span>
        </div>
      )
    }
  </div>
</div>

<style>
  .tournament-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--bg-card);
    border: var(--border-pixel-md);
    border-image: linear-gradient(
        135deg,
        var(--color-secondary-500),
        var(--color-vibrant-500),
        var(--color-warm-500)
      )
      1;
    box-shadow: var(--shadow-lg);
    position: relative;
  }

  .tournament-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-secondary-500),
      var(--color-vibrant-500),
      var(--color-warm-500),
      var(--color-gold-500)
    );
  }

  .tournament-header__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tournament-header__title h1 {
    font-family: var(--font-heading);
    font-size: var(--heading-lg);
    line-height: var(--leading-tight);
    background: linear-gradient(135deg, var(--color-secondary-500), var(--color-vibrant-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }

  .tournament-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .tournament-header__dates,
  .tournament-header__participants {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .icon {
    flex-shrink: 0;
  }

  @media (min-width: 480px) {
    .tournament-header__title h1 {
      font-size: var(--heading-lg);
    }
  }

  @media (min-width: 1024px) {
    .tournament-header__title h1 {
      font-size: var(--heading-xl);
    }
  }
</style>
