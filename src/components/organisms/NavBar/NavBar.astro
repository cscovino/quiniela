---
export interface NavLinks {
  href: string;
  label: string;
  active: boolean;
}

export interface Props {
  links: NavLinks[];
  locale: 'en' | 'es';
  notificationCount?: number;
  className?: string;
  isLoggedIn?: boolean;
  userDisplayName?: string;
  isAdmin?: boolean;
}

const { links, locale, notificationCount = 0, className = '', userDisplayName } = Astro.props;

const otherLocale = locale === 'en' ? 'es' : 'en';
const otherLocaleLabel = locale === 'en' ? 'ES' : 'EN';
const otherLocaleHref = locale === 'en' ? '/' : '/en';
const loginHref = locale === 'en' ? '/en/login' : '/login';
const predictionsHref = locale === 'en' ? '/en/predictions' : '/predicciones';
---

<nav class={`nav-bar ${className}`} transition:name="navbar">
  <a href={locale === 'en' ? '/en' : '/'} class="nav-bar__brand">
    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M4 4h16v2H4zm0 14h16v2H4zM2 6h2v12H2zm18 0h2v12h-2zM8 9h2v6H8z"></path>
      <path d="M6 11h6v2H6zm8-2h2v2h-2zm2 4h2v2h-2z"></path>
    </svg>
    <span class="nav-bar__title">QUINIELA</span>
  </a>

  <!-- Public links: visible by default, CSS handles responsive hide/show -->
  <div class="nav-bar__links" data-auth-links>
    {
      links.map((link) => (
        <a href={link.href} class={`nav-bar__link ${link.active ? 'nav-bar__link--active' : ''}`}>
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="nav-bar__actions">
    <a
      href={otherLocaleHref}
      class={`nav-bar__btn ${locale === 'es' ? 'nav-bar__btn--active' : ''}`}
      aria-label={`Switch to ${otherLocale === 'en' ? 'English' : 'Spanish'}`}
    >
      {otherLocaleLabel}
    </a>

    <button
      type="button"
      class="nav-bar__btn nav-bar__btn--icon"
      id="theme-toggle"
      aria-label="Toggle theme"
    >
      <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
    </button>

    {
      notificationCount > 0 && (
        <button
          type="button"
          class="nav-bar__btn nav-bar__btn--icon nav-bar__btn--notification"
          aria-label="Notifications"
        >
          <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
          </svg>
          <span class="nav-bar__badge">{notificationCount}</span>
        </button>
      )
    }

    <!-- Always render both auth states to prevent hydration mismatch -->
    <div class="nav-bar__group nav-bar__group--desktop" data-auth-desktop>
      <svg
        class="icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="nav-bar__username" data-auth-username>{userDisplayName}</span>
      <button type="button" class="nav-bar__logout" id="logout-btn"> Logout </button>
    </div>
    <a href={loginHref} class="nav-bar__group--desktop" data-auth-login>
      <span class="nav-bar__login-btn">Login</span>
    </a>

    <button
      type="button"
      class="nav-bar__btn nav-bar__btn--icon nav-bar__hamburger"
      id="hamburger-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg
        class="icon hamburger-open"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="icon hamburger-close"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="nav-bar__mobile-menu" id="mobile-menu">
    <!-- Public mobile links: visible by default when menu opens -->
    <div class="nav-bar__mobile-links" data-auth-mobile-links>
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`nav-bar__mobile-link ${link.active ? 'nav-bar__mobile-link--active' : ''}`}
            data-close-menu
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Always render both mobile auth states -->
    <div class="nav-bar__mobile-user" data-auth-mobile-user>
      <svg
        class="icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span data-auth-mobile-username>{userDisplayName}</span>
      <button type="button" class="nav-bar__logout" id="mobile-logout-btn"> Logout </button>
    </div>

    <div class="nav-bar__mobile-cta" data-auth-mobile-cta>
      <a href={predictionsHref} data-close-menu>
        <span class="nav-bar__cta-btn">
          {locale === 'en' ? 'Make Predictions' : 'Hacer Predicciones'}
        </span>
      </a>
    </div>

    <div class="nav-bar__mobile-cta" data-auth-mobile-login-cta>
      <a href={loginHref} data-close-menu>
        <span class="nav-bar__cta-btn">{locale === 'en' ? 'Login' : 'Iniciar Sesión'}</span>
      </a>
    </div>
  </div>
</nav>

<script src="../../../scripts/nav-auth.ts"></script>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-card);
    border-bottom: var(--border-pixel-md);
    border-image: linear-gradient(
        90deg,
        var(--color-secondary-500),
        var(--color-vibrant-500),
        var(--color-warm-500)
      )
      1;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 0;
    z-index: 100;
    gap: var(--space-4);
  }

  .nav-bar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-secondary-500),
      var(--color-vibrant-500),
      var(--color-warm-500),
      var(--color-gold-500)
    );
  }

  .nav-bar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
  }

  .nav-bar__title {
    font-family: var(--font-pixel);
    font-size: var(--text-lg);
    white-space: nowrap;
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-bar__links {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-bar__link {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border: var(--border-pixel-sm) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__link:hover {
    color: var(--text-primary);
    text-decoration: none;
    background: var(--bg-card-hover);
  }

  .nav-bar__link--active {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
    background: var(--bg-card-hover);
  }

  .nav-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-bar__btn {
    padding: var(--space-1) var(--space-2);
    background: var(--bg-input);
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__btn:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .nav-bar__btn--active {
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border-color: var(--color-accent-700);
  }

  .nav-bar__btn--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    position: relative;
  }

  .nav-bar__btn--notification {
    color: var(--color-accent-500);
  }

  .nav-bar__badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--color-error);
    color: #ffffff;
    font-family: var(--font-pixel);
    font-size: 8px;
    line-height: 16px;
    text-align: center;
    border: var(--border-pixel-sm) solid var(--bg-card);
  }

  .nav-bar__group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-bar__username {
    color: var(--text-primary);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-bar__logout {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    background: var(--bg-input);
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__logout:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .nav-bar__login-btn {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    background: var(--bg-input);
    color: var(--text-secondary);
    border: var(--border-pixel-sm) solid var(--border-color);
    text-decoration: none;
    display: inline-block;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__login-btn:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .nav-bar__hamburger {
    display: flex;
  }

  .nav-bar__group--desktop {
    display: none;
  }

  .hamburger-close {
    display: none;
  }

  .nav-bar__mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-card);
    border-bottom: var(--border-pixel-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-4);
    z-index: 100;
  }

  .nav-bar__mobile-menu.open {
    display: block;
  }

  .nav-bar__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .nav-bar__mobile-link {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border: var(--border-pixel-sm) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__mobile-link:hover {
    color: var(--text-primary);
    background: var(--bg-card-hover);
  }

  .nav-bar__mobile-link--active {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
    background: var(--bg-card-hover);
  }

  .nav-bar__mobile-user {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: var(--border-pixel-sm) solid var(--border-color);
    border-bottom: var(--border-pixel-sm) solid var(--border-color);
    margin-bottom: var(--space-4);
  }

  .nav-bar__mobile-cta {
    display: flex;
    justify-content: center;
  }

  .nav-bar__cta-btn {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border: var(--border-pixel-sm) solid var(--color-accent-700);
    text-decoration: none;
    display: block;
    text-align: center;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .nav-bar__cta-btn:hover {
    background: var(--color-accent-600);
  }

  .icon {
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .nav-bar {
      padding: var(--space-3) var(--space-4);
    }

    .nav-bar__links {
      display: flex;
    }

    .nav-bar__group--desktop {
      display: flex;
    }

    .nav-bar__hamburger {
      display: none;
    }

    .nav-bar__mobile-menu {
      display: none !important;
    }

    .nav-bar__title {
      font-size: var(--text-xl);
    }

    .nav-bar__actions {
      gap: var(--space-3);
    }
  }
</style>
