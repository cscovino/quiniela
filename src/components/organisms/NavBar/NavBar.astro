---
export interface NavLinks {
  href: string;
  label: string;
  active: boolean;
}

export interface Props {
  links: NavLinks[];
  locale: 'en' | 'es';
  notificationCount?: number;
  className?: string;
  isLoggedIn?: boolean;
  userDisplayName?: string;
  isAdmin?: boolean;
}

const {
  links,
  locale,
  notificationCount = 0,
  className = '',
  isLoggedIn = false,
  userDisplayName,
  isAdmin = false,
} = Astro.props;

const otherLocale = locale === 'en' ? 'es' : 'en';
const otherLocaleLabel = locale === 'en' ? 'ES' : 'EN';
const otherLocaleHref = locale === 'en' ? '/' : '/en';
const loginHref = locale === 'en' ? '/en/login' : '/login';
const predictionsHref = locale === 'en' ? '/en/predictions' : '/predicciones';
const adminHref = '/en/admin/matches';
---

<nav class={`nav-bar ${className}`}>
  <a href={locale === 'en' ? '/en' : '/'} class="nav-bar__brand">
    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95.49-7.4-2.97-6.91-6.92.24-1.93 1.44-3.55 3.11-4.5l1.31 2.28c-.79.47-1.33 1.28-1.42 2.21-.24 1.94 1.16 3.34 3.1 3.1.93-.09 1.74-.63 2.21-1.42l2.28 1.31c-.95 1.67-2.57 2.87-4.5 3.11-.19.02-.38.03-.58.03v.8z"
      ></path>
    </svg>
    <span class="nav-bar__title">QUINIELA</span>
  </a>

  {
    isLoggedIn && (
      <div class="nav-bar__links">
        {links.map((link) => (
          <a href={link.href} class={`nav-bar__link ${link.active ? 'nav-bar__link--active' : ''}`}>
            {link.label}
          </a>
        ))}
      </div>
    )
  }

  <div class="nav-bar__actions">
    <a
      href={otherLocaleHref}
      class={`nav-bar__btn ${locale === 'es' ? 'nav-bar__btn--active' : ''}`}
      aria-label={`Switch to ${otherLocale === 'en' ? 'English' : 'Spanish'}`}
    >
      {otherLocaleLabel}
    </a>

    <button
      type="button"
      class="nav-bar__btn nav-bar__btn--icon"
      id="theme-toggle"
      aria-label="Toggle theme"
    >
      <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
    </button>

    {
      notificationCount > 0 && (
        <button
          type="button"
          class="nav-bar__btn nav-bar__btn--icon nav-bar__btn--notification"
          aria-label="Notifications"
        >
          <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
          </svg>
          <span class="nav-bar__badge">{notificationCount}</span>
        </button>
      )
    }

    {
      isLoggedIn ? (
        <div class="nav-bar__group nav-bar__group--desktop">
          {isAdmin && (
            <a href={adminHref} class="nav-bar__link">
              Admin
            </a>
          )}
          <svg
            class="icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span class="nav-bar__username">{userDisplayName}</span>
          <button type="button" class="nav-bar__logout" id="logout-btn">
            Logout
          </button>
        </div>
      ) : (
        <a href={loginHref} class="nav-bar__group--desktop">
          <span class="nav-bar__login-btn">Login</span>
        </a>
      )
    }

    <button
      type="button"
      class="nav-bar__btn nav-bar__btn--icon nav-bar__hamburger"
      id="hamburger-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg
        class="icon hamburger-open"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="icon hamburger-close"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        style="display: none;"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="nav-bar__mobile-menu" id="mobile-menu" style="display: none;">
    {
      isLoggedIn && (
        <div class="nav-bar__mobile-links">
          {links.map((link) => (
            <a
              href={link.href}
              class={`nav-bar__mobile-link ${link.active ? 'nav-bar__mobile-link--active' : ''}`}
              data-close-menu
            >
              {link.label}
            </a>
          ))}
          {isAdmin && (
            <a href={adminHref} class="nav-bar__mobile-link" data-close-menu>
              Admin
            </a>
          )}
        </div>
      )
    }

    {
      isLoggedIn ? (
        <>
          <div class="nav-bar__mobile-user">
            <svg
              class="icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>{userDisplayName}</span>
            <button type="button" class="nav-bar__logout" id="mobile-logout-btn">
              Logout
            </button>
          </div>

          <div class="nav-bar__mobile-cta">
            <a href={predictionsHref} data-close-menu>
              <span class="nav-bar__cta-btn">
                {locale === 'en' ? 'Make Predictions' : 'Hacer Predicciones'}
              </span>
            </a>
          </div>
        </>
      ) : (
        <div class="nav-bar__mobile-cta">
          <a href={loginHref} data-close-menu>
            <span class="nav-bar__cta-btn">{locale === 'en' ? 'Login' : 'Iniciar Sesión'}</span>
          </a>
        </div>
      )
    }
  </div>
</nav>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const themeToggle = document.getElementById('theme-toggle');
  const hamburgerOpen = hamburgerBtn?.querySelector('.hamburger-open');
  const hamburgerClose = hamburgerBtn?.querySelector('.hamburger-close');

  hamburgerBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.style.display !== 'none';
    if (mobileMenu) {
      mobileMenu.style.display = isOpen ? 'none' : 'block';
    }
    hamburgerBtn.setAttribute('aria-expanded', String(!isOpen));
    if (hamburgerOpen && hamburgerClose) {
      hamburgerOpen.style.display = isOpen ? 'block' : 'none';
      hamburgerClose.style.display = isOpen ? 'none' : 'block';
    }
  });

  document.querySelectorAll('[data-close-menu]').forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileMenu) {
        mobileMenu.style.display = 'none';
      }
      hamburgerBtn?.setAttribute('aria-expanded', 'false');
      if (hamburgerOpen && hamburgerClose) {
        hamburgerOpen.style.display = 'block';
        hamburgerClose.style.display = 'none';
      }
    });
  });

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });
</script>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-card);
    border-bottom: var(--border-pixel-md);
    border-image: linear-gradient(
        90deg,
        var(--color-secondary-500),
        var(--color-vibrant-500),
        var(--color-warm-500)
      )
      1;
    position: sticky;
    top: 0;
    z-index: 100;
    gap: var(--space-4);
  }

  .nav-bar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }

  .nav-bar__title {
    font-family: var(--font-heading);
    font-size: var(--heading-xs);
    line-height: var(--leading-tight);
    background: linear-gradient(135deg, var(--color-secondary-500), var(--color-vibrant-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-bar__links {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-bar__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__link:hover {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
  }

  .nav-bar__link--active {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
  }

  .nav-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-bar__btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__btn:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .nav-bar__btn--active {
    background: var(--color-accent-500);
    color: white;
    border-color: var(--color-accent-500);
  }

  .nav-bar__btn--icon {
    padding: var(--space-1);
    position: relative;
  }

  .nav-bar__btn--notification {
    position: relative;
  }

  .nav-bar__badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-error);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0 var(--space-1);
    min-width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-pixel-sm) solid var(--bg-card);
  }

  .nav-bar__group {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-bar__username {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .nav-bar__logout {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__logout:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .nav-bar__login-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent-500);
    color: white;
    border: var(--border-pixel-sm) solid var(--color-accent-500);
    text-decoration: none;
    display: inline-block;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .nav-bar__login-btn:hover {
    background: var(--color-accent-600);
  }

  .nav-bar__hamburger {
    display: flex;
  }

  .nav-bar__mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-card);
    border-bottom: var(--border-pixel-md);
    padding: var(--space-4);
    flex-direction: column;
    gap: var(--space-4);
    z-index: 99;
  }

  .nav-bar__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-bar__mobile-link {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border: var(--border-pixel-sm) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .nav-bar__mobile-link:hover,
  .nav-bar__mobile-link--active {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
  }

  .nav-bar__mobile-user {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-top: var(--border-pixel-sm) solid var(--border-color);
  }

  .nav-bar__mobile-cta {
    padding-top: var(--space-2);
  }

  .nav-bar__cta-btn {
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-500);
    color: white;
    border: var(--border-pixel-sm) solid var(--color-accent-500);
    text-decoration: none;
    display: block;
    text-align: center;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .nav-bar__cta-btn:hover {
    background: var(--color-accent-600);
  }

  .icon {
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .nav-bar__links {
      display: flex;
    }

    .nav-bar__group--desktop {
      display: flex;
    }

    .nav-bar__hamburger {
      display: none;
    }

    .nav-bar__mobile-menu {
      display: none !important;
    }
  }
</style>
