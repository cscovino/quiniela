---
import { getBuildData } from '@lib/build-data';
import { LiveStandings } from '@organisms/LiveStandings/LiveStandings';
import { LiveMatchList } from '@organisms/LiveMatchList/LiveMatchList';
import type { MatchCardProps } from '@molecules/MatchCard/MatchCard';
import { getTranslations } from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const isEs = locale === 'es';
const t = getTranslations(locale).common;

const buildData = await getBuildData(locale);

const standings = isEs
  ? buildData.standings.map((g) => ({
      ...g,
      name: g.name.replace(/^Group\b/i, 'Grupo'),
    }))
  : buildData.standings;

const standingsTranslations = {
  noGroups: t.pages.tournament.groupsEmpty,
  team: t.pages.tournament.team,
  pts: t.pages.tournament.pts,
  qualified: t.pages.tournament.qualified,
};

const matchTranslations = {
  scheduled: t.matchStatus.scheduled,
  live: t.matchStatus.live,
  finished: t.matchStatus.finished,
  postponed: t.matchStatus.postponed,
  cancelled: t.matchStatus.cancelled,
  vs: t.matchCard.vs,
};

const matches = buildData.allMatches as unknown as MatchCardProps[];
---

<main class="tournament-template__content">
  <header class="tournament-template__header">
    <h1>{t.tournament.name}</h1>
  </header>

  <div class="tournament-template__tabs" role="tablist">
    <button
      class="tournament-template__tab active"
      data-tab="standings"
      role="tab"
      aria-selected="true"
    >
      {t.pages.tournament.tabStandings}
    </button>
    <button class="tournament-template__tab" data-tab="matches" role="tab" aria-selected="false">
      {t.pages.tournament.tabMatches}
    </button>
  </div>

  <section class="tournament-template__standings" data-panel="standings">
    <h2>{t.pages.tournament.groupStage}</h2>
    <LiveStandings
      initialGroups={standings}
      cacheKey="tournament-standings"
      translations={standingsTranslations}
      locale={locale}
      client:load
    />
  </section>

  <section class="tournament-template__matches" data-panel="matches" hidden>
    <LiveMatchList
      initialMatches={matches}
      cacheKey="tournament-matches"
      showAll
      title={t.pages.tournament.allMatches}
      emptyMessage={t.pages.tournament.matchesEmpty}
      translations={matchTranslations}
      locale={locale}
      client:load
    />
  </section>
</main>

<style>
  .tournament-template__content {
    width: 100%;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
  }

  .tournament-template__header {
    margin-bottom: var(--space-4);
  }

  .tournament-template__header h1 {
    font-family: var(--font-pixel);
    font-size: var(--heading-sm);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tournament-template__tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tournament-template__tab {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-input);
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .tournament-template__tab.active {
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border-color: var(--color-accent-700);
  }

  .tournament-template__standings h2 {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 1024px) {
    .tournament-template__content {
      padding: var(--space-4) var(--space-4);
    }
    .tournament-template__header h1 {
      font-size: var(--heading-md);
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    var tabs = document.querySelectorAll('.tournament-template__tab');
    var panels = document.querySelectorAll('[data-panel]');
    if (tabs.length === 0) return;
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        panels.forEach(function (p) {
          p.hidden = p.getAttribute('data-panel') !== target;
        });
      });
    });
  });
</script>
