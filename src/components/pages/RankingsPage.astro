---
import { getBuildRankings } from '@lib/build-data';
import { LiveRankings } from '@organisms/LiveRankings/LiveRankings';
import { getTranslations } from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const t = getTranslations(locale).common.pages.rankings;
const tTable = getTranslations(locale).common.rankingsTable;

const rankings = await getBuildRankings();
---

<main class="rankings-template__content">
  <LiveRankings
    initialRankings={rankings}
    cacheKey="rankings"
    title={t.heading}
    emptyMessage={t.empty}
    previousLabel={tTable.previous}
    nextLabel={tTable.next}
    pageLabel={tTable.pageLabel}
    client:load
  />
</main>

<style>
  .rankings-template__content {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
  }

  @media (min-width: 1024px) {
    .rankings-template__content {
      padding: var(--space-4) var(--space-4);
    }
  }
</style>
