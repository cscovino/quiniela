---
import { SCORING } from '@/config/scoring';
import { BADGE_DEFINITIONS } from '@app-types/badges';
import { Icon } from '@atoms/Icon';
import { PixelArt } from '@atoms/PixelArt/PixelArt';
import { getTranslations } from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const t = getTranslations(locale).rules.rules;

// Scoring categories data for grid rendering
const scoringCategories = [
  {
    key: 'match',
    title: t.scoring.match,
    rows: [
      { outcome: t.outcomes.exact, points: SCORING.MATCH.EXACT, highlight: true },
      { outcome: t.outcomes.winner, points: SCORING.MATCH.WINNER },
      { outcome: t.outcomes.draw, points: SCORING.MATCH.DRAW },
      { outcome: t.outcomes.wrong, points: SCORING.MATCH.WRONG },
    ],
  },
  {
    key: 'group',
    title: t.scoring.group,
    rows: [
      { outcome: t.outcomes.exactPosition, points: SCORING.GROUP.EXACT_POSITION, highlight: true },
      { outcome: t.outcomes.qualified, points: SCORING.GROUP.QUALIFIED },
    ],
  },
  {
    key: 'finalFour',
    title: t.scoring.finalFour,
    rows: [
      {
        outcome: t.outcomes.exactPosition,
        points: SCORING.FINAL_FOUR.EXACT_POSITION,
        highlight: true,
      },
      { outcome: t.outcomes.qualified, points: SCORING.FINAL_FOUR.QUALIFIED },
    ],
  },
  {
    key: 'bestPlayers',
    title: t.scoring.bestPlayers,
    rows: [{ outcome: t.outcomes.exact, points: SCORING.BEST_PLAYER.CORRECT, highlight: true }],
  },
];
---

<main class="rules-page">
  <!-- Section 1: Scoring Rules -->
  <section class="rules-page__scoring">
    <header class="rules-page__header">
      <h1>{t.heading}</h1>
    </header>

    <!-- Scoring Categories Grid -->
    <div class="scoring-grid">
      {
        scoringCategories.map((category) => (
          <div class="scoring-card">
            <h2 class="scoring-card__title">{category.title}</h2>
            <div class="scoring-card__rows">
              {category.rows.map((row) => (
                <div class={`scoring-row${row.highlight ? ' scoring-row--highlight' : ''}`}>
                  <span class="scoring-row__outcome">{row.outcome}</span>
                  <span class="scoring-row__points">{row.points}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- SCORE-04: Knockout Winners Disclaimer -->
    <div class="rules-callout rules-callout--warning">
      <span class="rules-callout__icon">
        <Icon name="warning" />
      </span>
      <div>
        <strong>{t.predictionOnly.label}</strong>
        <p>{t.predictionOnly.description}</p>
      </div>
    </div>
  </section>

  <!-- Section 2: Badges -->
  <section class="rules-page__badges">
    <h2>{t.badges.title}</h2>
    <div class="badges-grid">
      {
        BADGE_DEFINITIONS.map((badge) => (
          <div class="badge-card" data-badge-id={badge.id}>
            <span class="badge-card__icon">
              <Icon name={badge.icon} />
            </span>
            <h3 class="badge-card__name">{badge.name[locale]}</h3>
            <p class="badge-card__description">{badge.description[locale]}</p>
            <p class="badge-card__condition">
              <span>{t.badges.howToEarn}:</span> {badge.condition[locale]}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Section 3: Prizes -->
  <section class="rules-page__prizes">
    <h2>{t.prizes.title}</h2>
    <div class="prizes-grid">
      <div class="prize-card prize-card--gold">
        <PixelArt name="medal-gold" size={40} className="prize-medal" />
        <span class="prize-card__place">{t.prizes.firstPlace}</span>
        <span class="prize-card__percentage">60%</span>
      </div>
      <div class="prize-card prize-card--silver">
        <PixelArt name="medal-silver" size={40} className="prize-medal" />
        <span class="prize-card__place">{t.prizes.secondPlace}</span>
        <span class="prize-card__percentage">25%</span>
      </div>
      <div class="prize-card prize-card--bronze">
        <PixelArt name="medal-bronze" size={40} className="prize-medal" />
        <span class="prize-card__place">{t.prizes.thirdPlace}</span>
        <span class="prize-card__percentage">10%</span>
      </div>
      <div class="prize-card prize-card--exact">
        <PixelArt name="goal" size={40} className="prize-medal" />
        <span class="prize-card__place">{t.prizes.mostExact}</span>
        <span class="prize-card__percentage">5%</span>
      </div>
    </div>
    <p class="prizes-tiebreaker">{t.prizes.tiebreaker}</p>
  </section>
</main>

<style>
  .rules-page {
    width: 100%;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-4) var(--space-2);
  }

  .rules-page__header {
    margin-bottom: var(--space-6);
  }

  .rules-page__header h1 {
    font-family: var(--font-pixel);
    font-size: var(--heading-sm);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rules-page__scoring {
    margin-bottom: var(--space-8);
  }

  /* Scoring Grid - Responsive Cards */
  .scoring-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .scoring-card {
    background: var(--bg-card);
    border: var(--border-pixel-sm);
    padding: var(--space-3);
    box-shadow: var(--shadow-sm);
  }

  .scoring-card__title {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
    color: var(--color-gold-500);
  }

  .scoring-card__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .scoring-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2);
    background: var(--bg-input);
    border: 1px solid var(--border-color);
  }

  .scoring-row--highlight {
    border-color: var(--color-accent-500);
    background: var(--color-accent-900);
  }

  .scoring-row__outcome {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .scoring-row__points {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--color-accent-500);
  }

  .scoring-row--highlight .scoring-row__points {
    color: var(--color-gold-500);
  }

  /* Callout */
  .rules-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border: var(--border-pixel-sm);
    background: var(--bg-card);
    margin-top: var(--space-4);
    box-shadow: var(--shadow-sm);
  }

  .rules-callout--warning {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
  }

  .rules-callout__icon {
    flex-shrink: 0;
    color: var(--color-warning);
  }

  .rules-callout strong {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    display: block;
    margin-bottom: var(--space-1);
  }

  .rules-callout p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Badges Section */
  .rules-page__badges {
    margin-top: var(--space-8);
  }

  .rules-page__badges h2 {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    color: var(--color-gold-500);
  }

  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
  }

  .badge-card {
    padding: var(--space-3);
    border: var(--border-pixel-sm);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .badge-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .badge-card__icon {
    margin-bottom: var(--space-2);
    color: var(--color-gold-500);
    svg {
      width: 32px;
      height: 32px;
      path {
        fill: currentColor;
      }
    }
  }

  .badge-card__name {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .badge-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .badge-card__condition {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .badge-card__condition span {
    font-family: var(--font-pixel);
    color: var(--text-secondary);
  }

  /* Prizes Section */
  .rules-page__prizes {
    margin-top: var(--space-8);
  }

  .rules-page__prizes h2 {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    color: var(--color-gold-500);
  }

  .prizes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .prize-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3);
    border: var(--border-pixel-sm);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .prize-medal {
    margin-bottom: var(--space-2);
  }

  .prize-card__place {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .prize-card__percentage {
    font-family: var(--font-pixel);
    font-size: var(--heading-sm);
  }

  .prize-card--gold {
    border-color: var(--color-gold-500);
  }

  .prize-card--gold .prize-card__percentage {
    color: var(--color-gold-500);
  }

  .prize-card--silver {
    border-color: var(--color-warm-400);
  }

  .prize-card--silver .prize-card__percentage {
    color: var(--color-warm-400);
  }

  .prize-card--bronze {
    border-color: var(--color-warning);
  }

  .prize-card--bronze .prize-card__percentage {
    color: var(--color-warning);
  }

  .prize-card--exact {
    border-color: var(--color-accent-500);
  }

  .prize-card--exact .prize-card__percentage {
    color: var(--color-accent-500);
  }

  .prizes-tiebreaker {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .rules-page {
      padding: var(--space-2);
    }

    .scoring-grid {
      grid-template-columns: 1fr;
    }

    .badges-grid {
      grid-template-columns: 1fr;
    }

    .rules-page__header h1 {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1024px) {
    .rules-page {
      padding: var(--space-4) var(--space-4);
    }

    .rules-page__header h1 {
      font-size: var(--heading-md);
    }

    .scoring-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .prizes-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
