---
import { PredictionsTemplate } from '@templates/PredictionsTemplate/PredictionsTemplate';
import { getTranslations } from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const p = getTranslations(locale).common.pages.predictions;

const translations = {
  title: p.heading,
  noMatches: p.noMatches,
  submitSuccess: p.submitSuccess,
  submitError: p.submitError,
  captchaError: p.captchaError,
  loginRequired: p.loginRequired,
  loginButton: p.loginButton,
  loading: p.loading,
  stepFinalPhase: p.stepFinalPhase,
  stepFinalPhaseDesc: p.stepFinalPhaseDesc,
  stepBestPlayers: p.stepBestPlayers,
  stepBestPlayersDesc: p.stepBestPlayersDesc,
  buttonNext: p.buttonNext,
  buttonBack: p.buttonBack,
  buttonSubmit: p.buttonSubmit,
  stepXofY: p.stepXofY,
  submitToAdvance: p.submitToAdvance,
  predictedStandings: p.predictedStandings,
  team: p.team,
  pts: p.pts,
  feedback: p.feedback,
  predictor: p.predictor,
  predictorList: p.predictorList,
  predictorEditor: p.predictorEditor,
  predictorDelete: p.predictorDelete,
  thirdPlaceHeading: p.thirdPlaceHeading,
  thirdPlaceSubtitle: p.thirdPlaceSubtitle,
  thirdPlaceAdvancing: p.thirdPlaceAdvancing,
  thirdPlaceEliminated: p.thirdPlaceEliminated,
  thirdPlaceBracketSlotLabel: p.thirdPlaceBracketSlotLabel,
  thirdPlaceAdjust: p.thirdPlaceAdjust,
  thirdPlaceContinue: p.thirdPlaceContinue,
  thirdPlaceGroup: p.thirdPlaceGroup,
  thirdPlacePts: p.thirdPlacePts,
  thirdPlacePt: p.thirdPlacePt,
  deadlinePassed: p.deadlinePassed,
  deadlineCountdown: p.deadlineCountdown,
  tour: p.tour,
  stepDescriptionGroup: p.stepDescriptionGroup,
  stepDescriptionRound: p.stepDescriptionRound,
  groupStep: p.groupStep,
  knockoutStep: p.knockoutStep,
  finalPhaseStep: { teamsSoon: p.finalPhaseStep.teamsSoon, form: p.finalPhaseStep },
  bestPlayersStep: p.bestPlayersStep,
};
---

<main class="predictions-template__page">
  <PredictionsTemplate translations={translations} locale={locale} client:load />
</main>

<style>
  .predictions-template__page {
    width: 100%;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
  }

  @media (min-width: 1024px) {
    .pedictions-template__content {
      padding: var(--space-4) var(--space-4);
    }
  }
</style>
