---
import { PredictionTemplate } from '@templates/PredictionTemplate/PredictionTemplate';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const translations = {
  title: locale === 'en' ? 'Matchday Predictions' : 'Predicciones de la Jornada',
  timeRemaining: locale === 'en' ? 'Time remaining:' : 'Tiempo restante:',
};

const mockMatches = [
  {
    matchId: 'match-1',
    homeTeam: { fifaCode: 'ARG', name: locale === 'en' ? 'Argentina' : 'Argentina' },
    awayTeam: { fifaCode: 'FRA', name: locale === 'en' ? 'France' : 'Francia' },
    phase: 'group' as const,
    predictionDeadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  },
  {
    matchId: 'match-2',
    homeTeam: { fifaCode: 'BRA', name: locale === 'en' ? 'Brazil' : 'Brasil' },
    awayTeam: { fifaCode: 'GER', name: locale === 'en' ? 'Germany' : 'Alemania' },
    phase: 'group' as const,
    predictionDeadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  },
];

const templateProps = {
  formProps: {
    matches: mockMatches,
  },
  deadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  translations,
  onSubmit: () => {},
};
---

<PredictionTemplate {...templateProps} client:load />
