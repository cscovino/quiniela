---
import { HomeTemplate } from '@templates/HomeTemplate/HomeTemplate';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const translations = {
  heroTitle: locale === 'en' ? 'Predict. Compet. Win.' : 'Predice. Compite. Gana.',
  heroSubtitle:
    locale === 'en'
      ? 'Make your predictions for every match and climb the leaderboard!'
      : 'Haz tus predicciones para cada partido y escala en la clasificación!',
  ctaPredictions: locale === 'en' ? 'Make Predictions' : 'Hacer Predicciones',
  ctaStandings: locale === 'en' ? 'View Standings' : 'Ver Clasificación',
  matchesTitle: locale === 'en' ? 'Upcoming Matches' : 'Próximos Partidos',
  rankingsTitle: locale === 'en' ? 'Top Players' : 'Mejores Jugadores',
  matchList: {
    scheduled: locale === 'en' ? 'Scheduled' : 'Programado',
    live: locale === 'en' ? 'LIVE' : 'EN VIVO',
    finished: locale === 'en' ? 'Finished' : 'Finalizado',
    postponed: locale === 'en' ? 'Postponed' : 'Pospuesto',
    cancelled: locale === 'en' ? 'Cancelled' : 'Cancelado',
    vs: locale === 'en' ? 'VS' : 'VS',
  },
};

const mockMatches = [
  {
    homeTeam: { fifaCode: 'ARG', name: locale === 'en' ? 'Argentina' : 'Argentina' },
    awayTeam: { fifaCode: 'FRA', name: locale === 'en' ? 'France' : 'Francia' },
    date: new Date('2026-06-15T18:00:00Z'),
    status: 'scheduled' as const,
    stadium: locale === 'en' ? 'Lusail Stadium' : 'Estadio Lusail',
  },
  {
    homeTeam: { fifaCode: 'BRA', name: locale === 'en' ? 'Brazil' : 'Brasil' },
    awayTeam: { fifaCode: 'GER', name: locale === 'en' ? 'Germany' : 'Alemania' },
    date: new Date('2026-06-16T20:00:00Z'),
    status: 'scheduled' as const,
    stadium: locale === 'en' ? 'Maracana' : 'Maracana',
  },
];

const mockRankings = [
  { userId: 'user-1', displayName: 'Carlos', points: 150, accuracy: 75, streak: 5 },
  { userId: 'user-2', displayName: 'Maria', points: 142, accuracy: 72, streak: 3 },
  { userId: 'user-3', displayName: 'Juan', points: 138, accuracy: 68, streak: 4 },
];

const templateProps = {
  tournamentProps: {
    name: locale === 'en' ? 'FIFA World Cup 2026' : 'Copa Mundial FIFA 2026',
    status: 'active' as const,
    startDate: new Date('2026-06-11'),
    endDate: new Date('2026-07-19'),
    participantCount: 48,
  },
  matches: mockMatches,
  rankings: mockRankings,
  translations,
  locale,
};
---

<HomeTemplate {...templateProps} client:load />
