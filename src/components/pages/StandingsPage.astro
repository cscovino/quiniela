---
import { StandingsTemplate } from '@templates/StandingsTemplate/StandingsTemplate';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const translations = {
  title: locale === 'en' ? 'Tournament Standings' : 'Clasificación del Torneo',
  groupStageTitle: locale === 'en' ? 'Group Stage' : 'Fase de Grupos',
  knockoutTitle: locale === 'en' ? 'Knockout Stage' : 'Fase Eliminatoria',
  standings: {
    noGroups: locale === 'en' ? 'No groups available' : 'No hay grupos disponibles',
    team: locale === 'en' ? 'Team' : 'Equipo',
    pts: locale === 'en' ? 'Pts' : 'Pts',
    qualified: locale === 'en' ? 'Qualified:' : 'Clasificados:',
  },
  bracket: {
    bracketNotAvailable:
      locale === 'en' ? 'Bracket not available yet' : 'El cuadro aún no está disponible',
    match: {
      scheduled: locale === 'en' ? 'Scheduled' : 'Programado',
      live: locale === 'en' ? 'LIVE' : 'EN VIVO',
      finished: locale === 'en' ? 'Finished' : 'Finalizado',
      postponed: locale === 'en' ? 'Postponed' : 'Pospuesto',
      cancelled: locale === 'en' ? 'Cancelled' : 'Cancelado',
      vs: locale === 'en' ? 'VS' : 'VS',
    },
  },
};

const mockGroups = [
  {
    name: locale === 'en' ? 'Group A' : 'Grupo A',
    standings: [
      {
        teamId: 'arg',
        teamName: 'Argentina',
        fifaCode: 'ARG',
        position: 1,
        played: 2,
        won: 2,
        drawn: 0,
        lost: 0,
        goalsFor: 5,
        goalsAgainst: 1,
        points: 6,
      },
      {
        teamId: 'fra',
        teamName: locale === 'en' ? 'France' : 'Francia',
        fifaCode: 'FRA',
        position: 2,
        played: 2,
        won: 1,
        drawn: 0,
        lost: 1,
        goalsFor: 3,
        goalsAgainst: 2,
        points: 3,
      },
      {
        teamId: 'jpn',
        teamName: locale === 'en' ? 'Japan' : 'Japon',
        fifaCode: 'JPN',
        position: 3,
        played: 2,
        won: 0,
        drawn: 1,
        lost: 1,
        goalsFor: 1,
        goalsAgainst: 3,
        points: 1,
      },
      {
        teamId: 'aus',
        teamName: locale === 'en' ? 'Australia' : 'Australia',
        fifaCode: 'AUS',
        position: 4,
        played: 2,
        won: 0,
        drawn: 1,
        lost: 1,
        goalsFor: 1,
        goalsAgainst: 4,
        points: 1,
      },
    ],
  },
];

const mockBracketRounds = [
  {
    name: locale === 'en' ? 'Round of 32' : 'Octavos de Final',
    matches: [
      {
        matchId: 'ko-1',
        homeTeam: { fifaCode: 'ARG', name: 'Argentina' },
        awayTeam: { fifaCode: 'FRA', name: locale === 'en' ? 'France' : 'Francia' },
        date: new Date('2026-07-01T18:00:00Z'),
        status: 'scheduled' as const,
      },
    ],
  },
];

const templateProps = {
  groups: mockGroups,
  bracketRounds: mockBracketRounds,
  translations,
  locale,
};
---

<StandingsTemplate {...templateProps} client:load />
