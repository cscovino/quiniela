---
import { ProfileTemplate } from '@templates/ProfileTemplate/ProfileTemplate';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const translations = {
  title: locale === 'en' ? 'My Profile' : 'Mi Perfil',
  loading: locale === 'en' ? 'Loading profile...' : 'Cargando perfil...',
  loginRequired:
    locale === 'en'
      ? 'You need to login to view your profile'
      : 'Necesitas iniciar sesión para ver tu perfil',
  loginButton: locale === 'en' ? 'Login' : 'Iniciar Sesión',
  totalPoints: locale === 'en' ? 'Total Points' : 'Puntos Totales',
  accuracy: locale === 'en' ? 'Accuracy' : 'Precisión',
  currentStreak: locale === 'en' ? 'Current Streak' : 'Racha Actual',
  bestStreak: locale === 'en' ? 'Best Streak' : 'Mejor Racha',
  exactBets: locale === 'en' ? 'Exact Bets' : 'Apuestas Exactas',
  rank: locale === 'en' ? 'Rank' : 'Posición',
  badges: locale === 'en' ? 'Badges' : 'Insignias',
};

const templateProps = {
  translations,
  locale,
};
---

<ProfileTemplate {...templateProps} client:load />
