---
import { ProfileTemplate } from '@templates/ProfileTemplate/ProfileTemplate';
import { getTranslations } from '@utils/i18n';

export interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const p = getTranslations(locale).common.pages.profile;
const pred = getTranslations(locale).common.pages.predictions;

const translations = {
  title: p.heading,
  loading: p.loading,
  loginRequired: p.loginRequired,
  loginButton: p.loginButton,
  totalPoints: p.totalPoints,
  accuracy: p.accuracy,
  currentStreak: p.currentStreak,
  bestStreak: p.bestStreak,
  exactBets: p.exactBets,
  rank: p.rank,
  badges: p.badges,
  lockedBadges: p.lockedBadges,
  pointsChart: p.pointsChart,
  noPointsData: p.noPointsData,
  points: p.points,
  matches: p.matches,
  days: p.days,
  yourPredictors: p.yourPredictors,
  selectPredictor: p.selectPredictor,
  editProfile: p.editProfile,
  cancelEditing: p.cancelEditing,
  saveProfile: p.saveProfile,
  saving: p.saving,
  profileSaved: p.profileSaved,
  profileSaveError: p.profileSaveError,
  displayNameLabel: p.displayNameLabel,
  displayNameRequired: p.displayNameRequired,
  avatarUrlLabel: p.avatarUrlLabel,
  avatarUrlHint: p.avatarUrlHint,
  favoriteTeamLabel: p.favoriteTeamLabel,
  favoriteTeamHint: p.favoriteTeamHint,
  predictorList: { ...pred.predictorList, viewAria: p.predictorList?.viewAria },
  statGrid: p.statGrid,
  chartAriaLabel: p.chartAriaLabel,
  legendToggleAria: p.legendToggleAria,
};
---

<ProfileTemplate translations={translations} locale={locale} client:idle />
