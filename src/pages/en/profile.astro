---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ProfileTemplate } from '@templates/ProfileTemplate/ProfileTemplate';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;

const mockUserProfile = {
  displayName: 'Carlos',
  avatarUrl: undefined,
  favoriteTeam: 'Argentina',
  stats: {
    totalPoints: 480,
    exactBets: 12,
    accuracy: 67,
    currentStreak: 5,
    maxStreak: 8,
    rank: 5,
  },
  badges: [
    { id: 'badge-1', name: 'First Prediction', icon: 'star', earnedAt: new Date('2026-06-11') },
  ],
};

const mockNotifications = [
  {
    id: 'notif-1',
    type: 'badge_earned' as const,
    title: 'New Badge',
    message: 'You earned 10 points!',
    read: false,
    createdAt: new Date(Date.now() - 60 * 60 * 1000),
  },
];

const templateProps = {
  navProps: {
    links: [
      { href: '/en', label: translations.nav.home, active: false },
      { href: '/en/predictions', label: translations.nav.predictions, active: false },
      { href: '/en/standings', label: translations.nav.standings, active: false },
      { href: '/en/profile', label: translations.nav.profile, active: true },
    ],
    locale: 'en' as const,
  },
  userProfile: mockUserProfile,
  notifications: mockNotifications,
  onNotificationDismiss: () => {},
};
---

<BaseLayout
  locale={locale}
  title={translations.pages.profile.title}
  description={translations.pages.profile.description}
  activeNav="profile"
>
  <ProfileTemplate {...templateProps} client:load />
</BaseLayout>
