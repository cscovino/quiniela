---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProfilePage from '@pages/ProfilePage.astro';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;
---

<BaseLayout
  locale={locale}
  title={translations.pages.profile.title}
  description={translations.pages.profile.description}
  activeNav="profile"
>
  <ProfilePage locale={locale} />
</BaseLayout>
