---
import BaseLayout from '@layouts/BaseLayout.astro';
import { RankingsTemplate } from '@templates/RankingsTemplate/RankingsTemplate';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;

const templateProps = {
  translations: {
    title: 'Predictor Rankings',
    noRankings: 'No rankings available yet. Make predictions to appear here!',
    loading: 'Loading rankings...',
  },
  locale,
};
---

<BaseLayout
  locale={locale}
  title={translations.pages.rankings.title}
  description={translations.pages.rankings.description}
  activeNav="rankings"
>
  <RankingsTemplate {...templateProps} client:idle />
</BaseLayout>
