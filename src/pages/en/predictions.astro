---
import BaseLayout from '@layouts/BaseLayout.astro';
import { PredictionTemplate } from '@templates/PredictionTemplate/PredictionTemplate';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;

const mockMatches = [
  {
    matchId: 'match-1',
    homeTeam: { fifaCode: 'ARG', name: 'Argentina' },
    awayTeam: { fifaCode: 'FRA', name: 'France' },
    phase: 'group' as const,
    predictionDeadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  },
  {
    matchId: 'match-2',
    homeTeam: { fifaCode: 'BRA', name: 'Brazil' },
    awayTeam: { fifaCode: 'GER', name: 'Germany' },
    phase: 'group' as const,
    predictionDeadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  },
];

const templateProps = {
  navProps: {
    links: [
      { href: '/en', label: translations.nav.home, active: false },
      { href: '/en/predictions', label: translations.nav.predictions, active: true },
      { href: '/en/standings', label: translations.nav.standings, active: false },
      { href: '/en/profile', label: translations.nav.profile, active: false },
    ],
    locale: 'en' as const,
  },
  formProps: {
    matches: mockMatches,
  },
  deadline: new Date(Date.now() + 24 * 60 * 60 * 1000),
  onSubmit: () => {},
};
---

<BaseLayout
  locale={locale}
  title={translations.pages.predictions.title}
  description={translations.pages.predictions.description}
  activeNav="predictions"
>
  <PredictionTemplate {...templateProps} client:load />
</BaseLayout>
