---
import BaseLayout from '@layouts/BaseLayout.astro';
import StandingsPage from '@pages/StandingsPage.astro';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;
---

<BaseLayout
  locale={locale}
  title={translations.pages.standings.title}
  description={translations.pages.standings.description}
  activeNav="standings"
>
  <StandingsPage locale={locale} />
</BaseLayout>
