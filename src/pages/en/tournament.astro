---
import BaseLayout from '@layouts/BaseLayout.astro';
import { TournamentTemplate } from '@templates/TournamentTemplate/TournamentTemplate';
import en from '@locales/en/common.json';

const locale = 'en';
const translations = en;
---

<BaseLayout
  locale={locale}
  title={translations.pages.tournament?.title || 'Tournament - Quiniela'}
  description={translations.pages.tournament?.description ||
    'Group standings and tournament matches'}
  activeNav="tournament"
>
  <TournamentTemplate
    client:idle
    locale={locale}
    translations={{
      title: 'Tournament',
      standingsTab: 'Standings',
      matchesTab: 'Matches',
      groupStageTitle: 'Group Stage',
      allMatchesTitle: 'All Matches',
      noStandings: 'No standings available',
      noMatches: 'No matches available',
      matchList: {
        scheduled: 'Scheduled',
        live: 'LIVE',
        finished: 'Finished',
        postponed: 'Postponed',
        cancelled: 'Cancelled',
        vs: 'VS',
      },
    }}
  />
</BaseLayout>
