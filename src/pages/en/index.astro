---
import '../../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import common from '../../locales/en/common.json';

const locale = 'en';
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{common.site.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main
      style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;"
    >
      <nav style="position: absolute; top: 1rem; right: 1rem; display: flex; gap: 0.5rem;">
        <a
          href={getRelativeLocaleUrl('en')}
          style="padding: 0.5rem 0.75rem; border: var(--border-pixel); background: var(--color-primary-500); color: var(--text-primary); font-family: var(--font-pixel); font-size: 0.5rem;"
        >
          English
        </a>
        <a
          href={getRelativeLocaleUrl('es')}
          style="padding: 0.5rem 0.75rem; border: var(--border-pixel); background: var(--bg-card); color: var(--text-primary); font-family: var(--font-pixel); font-size: 0.5rem;"
        >
          Español
        </a>
      </nav>
      <h1
        style="font-size: 1.5rem; color: var(--color-accent-500); text-shadow: var(--shadow-pixel);"
      >
        {common.site.title}
      </h1>
      <p style="font-family: var(--font-pixel); font-size: 0.625rem; color: var(--text-secondary);">
        {common.site.tagline}
      </p>
      <div
        style="margin-top: 2rem; padding: 1.5rem; border: var(--border-pixel); background: var(--bg-card); box-shadow: var(--shadow-pixel);"
      >
        <p style="font-size: 0.75rem; color: var(--text-primary);">
          {common.common.comingSoon}
        </p>
      </div>
    </main>
  </body>
</html>
