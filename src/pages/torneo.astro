---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getBuildData } from '@lib/build-data';
import es from '@locales/es/common.json';

const locale = 'es';
const translations = es;

const buildData = await getBuildData();

const standings = buildData.standings;
---

<BaseLayout
  locale={locale}
  title={translations.pages.tournament?.title || 'Torneo - Quiniela'}
  description={translations.pages.tournament?.description ||
    'Clasificación de grupos y partidos del torneo'}
  activeNav="tournament"
>
  <main class="tournament-template__content">
    <header class="tournament-template__header">
      <h1>Torneo</h1>
    </header>

    <div class="tournament-template__tabs" role="tablist">
      <button
        class="tournament-template__tab active"
        data-tab="standings"
        role="tab"
        aria-selected="true">Clasificación</button
      >
      <button class="tournament-template__tab" data-tab="matches" role="tab" aria-selected="false"
        >Partidos</button
      >
    </div>

    <section class="tournament-template__standings" data-panel="standings">
      <h2>Fase de Grupos</h2>
      {
        standings.length > 0 ? (
          standings.map((group) => (
            <div class="group-standings">
              <h3 class="group-standings__name">{group.name}</h3>
              <table class="group-standings__table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Equipo</th>
                    <th>P</th>
                    <th>G</th>
                    <th>E</th>
                    <th>P</th>
                    <th>GF</th>
                    <th>GC</th>
                    <th>Pts</th>
                  </tr>
                </thead>
                <tbody>
                  {group.standings.map((s) => (
                    <tr>
                      <td>{s.position}</td>
                      <td class="group-standings__team">{s.fifaCode}</td>
                      <td>{s.played}</td>
                      <td>{s.won}</td>
                      <td>{s.drawn}</td>
                      <td>{s.lost}</td>
                      <td>{s.goalsFor}</td>
                      <td>{s.goalsAgainst}</td>
                      <td class="group-standings__pts">{s.points}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        ) : (
          <p class="tournament-template__empty">No hay clasificación disponible</p>
        )
      }
    </section>

    <section class="tournament-template__matches" data-panel="matches" hidden>
      <div id="matches-content">
        <p class="tournament-template__empty">Cargando partidos...</p>
      </div>
    </section>
  </main>

  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      var tabs = document.querySelectorAll('.tournament-template__tab');
      var panels = document.querySelectorAll('[data-panel]');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          tabs.forEach(function (t) {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          panels.forEach(function (p) {
            p.hidden = p.getAttribute('data-panel') !== target;
          });
        });
      });

      var matchesLoaded = false;
      var matchesTab = document.querySelector('[data-tab="matches"]');
      if (matchesTab) {
        matchesTab.addEventListener('click', function () {
          if (matchesLoaded) return;
          matchesLoaded = true;
          fetch('/api/live')
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              var container = document.getElementById('matches-content');
              if (!container) return;
              if (!data || data.length === 0) {
                container.innerHTML =
                  '<p class="tournament-template__empty">No hay partidos disponibles</p>';
                return;
              }
              var html = '';
              data.forEach(function (m) {
                html += '<div class="match-card">';
                html += '<div class="match-card__teams">';
                html += '<div class="match-card__team match-card__team--home">';
                html += '<span class="team-flag">' + (m.homeTeamFifaCode || 'TBD') + '</span>';
                html += '<span class="team-name">' + (m.homeTeamName || 'TBD') + '</span>';
                if (m.result && m.result.home !== null) {
                  html += '<span class="match-card__score">' + m.result.home + '</span>';
                }
                html += '</div>';
                html += '<div class="match-card__vs"><span class="vs-text">VS</span></div>';
                html += '<div class="match-card__team match-card__team--away">';
                if (m.result && m.result.away !== null) {
                  html += '<span class="match-card__score">' + m.result.away + '</span>';
                }
                html += '<span class="team-name">' + (m.awayTeamName || 'TBD') + '</span>';
                html += '<span class="team-flag">' + (m.awayTeamFifaCode || 'TBD') + '</span>';
                html += '</div>';
                html += '</div>';
                html += '<div class="match-card__footer">';
                html += '<div class="match-card__meta">';
                html += '<span class="match-date">' + (m.date || '') + '</span>';
                if (m.stadium) {
                  html += '<span class="match-card__stadium">' + m.stadium + '</span>';
                }
                html += '</div>';
                if (m.status && m.status !== 'scheduled') {
                  html += '<span class="badge badge--' + m.status + '">' + m.status + '</span>';
                }
                html += '</div></div>';
              });
              container.innerHTML = html;
            })
            .catch(function () {
              var container = document.getElementById('matches-content');
              if (container)
                container.innerHTML =
                  '<p class="tournament-template__empty">Error al cargar partidos</p>';
            });
        });
      }
    });
  </script>
</BaseLayout>

<style>
  .tournament-template__content {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
  }

  .tournament-template__header {
    margin-bottom: var(--space-4);
  }

  .tournament-template__header h1 {
    font-family: var(--font-pixel);
    font-size: var(--heading-sm);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tournament-template__tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tournament-template__tab {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-input);
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .tournament-template__tab.active {
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border-color: var(--color-accent-700);
  }

  .tournament-template__standings h2 {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .group-standings {
    margin-bottom: var(--space-4);
  }

  .group-standings__name {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
  }

  .group-standings__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
  }

  .group-standings__table th,
  .group-standings__table td {
    padding: var(--space-2);
    text-align: center;
    border-bottom: var(--border-pixel-sm);
  }

  .group-standings__table th {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-input);
  }

  .group-standings__team {
    font-family: var(--font-pixel);
    text-align: left !important;
  }

  .group-standings__pts {
    font-weight: bold;
    color: var(--color-accent-500);
  }

  .tournament-template__empty {
    text-align: center;
    color: var(--text-secondary);
    padding: var(--space-6);
  }

  .match-card {
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    max-width: 100%;
    position: relative;
    margin-bottom: var(--space-3);
  }

  .match-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-secondary-500), var(--color-vibrant-500));
  }

  .match-card__teams {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .match-card__team {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
    width: 100%;
    justify-content: center;
  }

  .match-card__team--away {
    flex-direction: row-reverse;
  }

  .match-card__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: var(--bg-input);
    border: var(--border-width-sm) solid var(--border-color);
    flex-shrink: 0;
    margin: var(--space-1) 0;
  }

  .vs-text {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .match-card__score {
    font-size: var(--text-xl);
    color: var(--color-accent-500);
    min-width: 2ch;
    text-align: center;
    flex-shrink: 0;
  }

  .match-card__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-pixel-sm);
  }

  .match-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    width: 100%;
    justify-content: space-between;
    font-size: var(--text-xs);
  }

  .match-card__stadium {
    color: var(--text-muted);
    text-align: center;
    font-size: var(--text-xs);
  }

  .badge {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }

  .badge--live {
    background: var(--color-warning-100);
    color: var(--color-warning-700);
  }
  .badge--finished {
    background: var(--color-success-100);
    color: var(--color-success-700);
  }

  .team-flag {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    background: var(--bg-input);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }

  .team-name {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
  }

  .match-date {
    font-size: var(--text-xs);
  }

  @media (min-width: 1024px) {
    .tournament-template__content {
      padding: var(--space-4) var(--space-4);
    }

    .tournament-template__header h1 {
      font-size: var(--heading-md);
    }

    .match-card {
      padding: var(--space-4);
    }

    .match-card__teams {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .match-card__team {
      width: auto;
      justify-content: flex-start !important;
    }

    .match-card__team--away {
      justify-content: flex-end !important;
    }

    .match-card__footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .match-card__meta {
      width: auto;
      justify-content: flex-start;
    }
  }
</style>
