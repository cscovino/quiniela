---
import BaseLayout from '@layouts/BaseLayout.astro';

const pathname = Astro.url.pathname;
const locale: 'en' | 'es' = pathname.startsWith('/es') ? 'es' : 'en';

const t = {
  en: {
    title: 'Page not found',
    heading: '404',
    subheading: 'Page not found',
    body: "The page you're looking for doesn't exist or has been moved.",
    home: 'Back to home',
  },
  es: {
    title: 'Página no encontrada',
    heading: '404',
    subheading: 'Página no encontrada',
    body: 'La página que buscas no existe o ha sido movida.',
    home: 'Volver al inicio',
  },
}[locale];

const homeHref = `/${locale}`;
---

<BaseLayout locale={locale} title={`${t.title} - Quiniela`} description={t.body}>
  <section class="not-found">
    <div class="not-found__inner">
      <h1 class="not-found__heading">{t.heading}</h1>
      <p class="not-found__subheading">{t.subheading}</p>
      <p class="not-found__body">{t.body}</p>
      <a class="not-found__cta" href={homeHref}>{t.home}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .not-found__inner {
    max-width: 32rem;
  }

  .not-found__heading {
    font-family: 'Press Start 2P', monospace;
    font-size: 4rem;
    margin: 0 0 1rem;
    color: #00bfff;
    letter-spacing: 0.05em;
  }

  .not-found__subheading {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    font-weight: 600;
  }

  .not-found__body {
    margin: 0 0 2rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .not-found__cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #00bfff;
    color: #000;
    text-decoration: none;
    font-weight: 600;
    border-radius: 0.5rem;
    transition: transform 0.15s ease;
  }

  .not-found__cta:hover {
    transform: translateY(-2px);
  }
</style>
