---
import BaseLayout from '@layouts/BaseLayout.astro';
import { HomeTemplate } from '@templates/HomeTemplate/HomeTemplate';
import es from '@locales/es/common.json';

const locale = 'es';
const translations = es;

const mockMatches = [
  {
    homeTeam: { fifaCode: 'ARG', name: 'Argentina' },
    awayTeam: { fifaCode: 'FRA', name: 'Francia' },
    date: new Date('2026-06-15T18:00:00Z'),
    status: 'scheduled' as const,
    stadium: 'Estadio Lusail',
  },
  {
    homeTeam: { fifaCode: 'BRA', name: 'Brasil' },
    awayTeam: { fifaCode: 'GER', name: 'Alemania' },
    date: new Date('2026-06-16T20:00:00Z'),
    status: 'scheduled' as const,
    stadium: 'Maracana',
  },
];

const mockRankings = [
  { position: 1, user: 'Carlos', points: 150, streak: 5 },
  { position: 2, user: 'Maria', points: 142, streak: 3 },
  { position: 3, user: 'Juan', points: 138, streak: 4 },
];

const templateProps = {
  tournamentProps: {
    name: 'Copa Mundial FIFA 2026',
    status: 'active' as const,
    startDate: new Date('2026-06-11'),
    endDate: new Date('2026-07-19'),
    participantCount: 48,
  },
  matches: mockMatches,
  rankings: mockRankings,
};
---

<BaseLayout
  locale={locale}
  title={translations.pages.home.title}
  description={translations.pages.home.description}
  activeNav="home"
>
  <HomeTemplate {...templateProps} client:load />
</BaseLayout>
