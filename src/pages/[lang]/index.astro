---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getBuildData } from '@lib/build-data';
import { TournamentHeader } from '@organisms/TournamentHeader/TournamentHeader';
import { LiveMatchList } from '@organisms/LiveMatchList/LiveMatchList';
import { Button } from '@atoms/Button/Button';
import type { MatchCardProps } from '@molecules/MatchCard/MatchCard';
import { getTranslations, getRoute } from '@utils/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' }, props: { locale: 'es' } },
    { params: { lang: 'en' }, props: { locale: 'en' } },
  ];
}

const { locale } = Astro.props;
const t = getTranslations(locale).common;

const buildData = await getBuildData();

const predictionsUrl = getRoute(locale, 'predictions');
const rankingsUrl = getRoute(locale, 'rankings');

const matchTranslations = {
  scheduled: t.matchStatus.scheduled,
  live: t.matchStatus.live,
  finished: t.matchStatus.finished,
  postponed: t.matchStatus.postponed,
  cancelled: t.matchStatus.cancelled,
  vs: t.matchCard.vs,
};

const matches = buildData.matches as unknown as MatchCardProps[];
const tournamentInfo = buildData.tournament;
---

<BaseLayout
  locale={locale}
  title={t.pages.home.title}
  description={t.pages.home.description}
  activeNav="home"
>
  <main class="home-template__content">
    <TournamentHeader
      name={t.tournament.name}
      status={tournamentInfo.status as 'draft' | 'active' | 'finished'}
      startDate={tournamentInfo.startDate}
      endDate={tournamentInfo.endDate}
      participantCount={tournamentInfo.participantCount}
      locale={locale}
      translations={{ teams: t.tournament.teams }}
    />

    <section class="home-template__hero">
      <h2 class="home-template__hero-title">{t.pages.home.hero.title}</h2>
      <p>{t.pages.home.hero.subtitle}</p>
      <div class="home-template__actions">
        <Button href={predictionsUrl} variant="primary" size="lg">
          {t.pages.home.hero.ctaPredict}
        </Button>
        <Button href={rankingsUrl} variant="secondary" size="lg">
          {t.pages.home.hero.ctaStandings}
        </Button>
      </div>
    </section>

    <section class="home-template__matches">
      <LiveMatchList
        initialMatches={matches}
        cacheKey="home-matches"
        limit={6}
        title={t.pages.home.matches.title}
        emptyMessage={t.pages.home.matches.empty}
        translations={matchTranslations}
        locale={locale}
        client:idle
      />
    </section>
  </main>
</BaseLayout>

<style>
  .home-template__content {
    flex: 1;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
    width: 100%;
  }

  .home-template__hero {
    text-align: center;
    padding: var(--space-4) var(--space-2);
    margin: var(--space-4) 0;
    background: linear-gradient(135deg, var(--color-primary-400), var(--color-accent-500));
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .home-template__hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-secondary-500),
      var(--color-vibrant-500),
      var(--color-warm-500),
      var(--color-gold-500)
    );
  }

  .home-template__hero-title {
    margin-bottom: var(--space-2);
    font-size: var(--heading-xs);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .home-template__hero p {
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .home-template__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
  }

  .home-template__matches {
    margin: var(--space-6) 0;
  }

  @media (min-width: 480px) {
    .home-template__content {
      padding: var(--space-3) var(--space-3);
    }

    .home-template__hero {
      padding: var(--space-6) var(--space-3);
      margin: var(--space-4) 0;
    }

    .home-template__hero-title {
      font-size: var(--heading-sm);
    }
  }

  @media (min-width: 1024px) {
    .home-template__content {
      padding: var(--space-4) var(--space-4);
    }

    .home-template__hero {
      padding: var(--space-8) var(--space-4);
      margin: var(--space-6) 0;
    }

    .home-template__hero-title {
      font-size: var(--heading-md);
    }

    .home-template__hero p {
      font-size: var(--text-base);
    }

    .home-template__actions {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
