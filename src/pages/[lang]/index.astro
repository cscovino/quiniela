---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getBuildData } from '@lib/build-data';
import es from '@locales/es/common.json';
import en from '@locales/en/common.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' }, props: { locale: 'es' } },
    { params: { lang: 'en' }, props: { locale: 'en' } },
  ];
}

const { locale } = Astro.props;
const translations = locale === 'en' ? en : es;
const isEs = locale === 'es';

const buildData = await getBuildData();

function formatDate(date: Date, loc: string) {
  return date.toLocaleDateString(loc === 'en' ? 'en-US' : 'es-ES', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function formatTime(date: Date, loc: string) {
  return date.toLocaleTimeString(loc === 'en' ? 'en-US' : 'es-ES', {
    hour: '2-digit',
    minute: '2-digit',
  });
}

function statusLabel(status: string, t: typeof es) {
  const labels: Record<string, string> = {
    scheduled: t.pages.home.matchList.scheduled,
    live: t.pages.home.matchList.live,
    finished: t.pages.home.matchList.finished,
    postponed: t.pages.home.matchList.postponed,
    cancelled: t.pages.home.matchList.cancelled,
  };
  return labels[status] || status;
}

function statusVariant(status: string) {
  const variants: Record<string, string> = {
    scheduled: 'info',
    live: 'warning',
    finished: 'success',
    postponed: 'accent',
    cancelled: 'error',
  };
  return variants[status] || 'info';
}

const predictionsUrl = isEs ? '/es/predicciones' : '/en/predictions';
const rankingsUrl = isEs ? '/es/clasificacion' : '/en/rankings';
---

<BaseLayout
  locale={locale}
  title={translations.pages.home.title}
  description={translations.pages.home.description}
  activeNav="home"
>
  <main class="home-template__content">
    <section class="home-template__hero">
      <h2 class="home-template__hero-title">
        {locale === 'en' ? 'Predict. Compete. Win.' : 'Predice. Compite. Gana.'}
      </h2>
      <p>
        {
          locale === 'en'
            ? 'Make your predictions for every match and climb the leaderboard!'
            : '¡Haz tus predicciones para cada partido y escala en la clasificación!'
        }
      </p>
      <div class="home-template__actions">
        <a href={predictionsUrl} class="btn btn--primary btn--lg">
          {locale === 'en' ? 'Make Predictions' : 'Hacer Predicciones'}
        </a>
        <a href={rankingsUrl} class="btn btn--secondary btn--lg">
          {locale === 'en' ? 'View Standings' : 'Ver Clasificación'}
        </a>
      </div>
    </section>

    <section class="home-template__matches">
      <h3>{locale === 'en' ? 'Upcoming Matches' : 'Próximos Partidos'}</h3>
      <div id="matches-container" class="match-list">
        {
          buildData.matches.length > 0 ? (
            buildData.matches.map((match) => (
              <div class="match-card">
                <div class="match-card__teams">
                  <div class="match-card__team match-card__team--home">
                    <span class="team-flag">{match.homeTeam.fifaCode}</span>
                    <span class="team-name">{match.homeTeam.name}</span>
                    {match.result && <span class="match-card__score">{match.result.home}</span>}
                  </div>
                  <div class="match-card__vs">
                    <span class="vs-text">VS</span>
                  </div>
                  <div class="match-card__team match-card__team--away">
                    {match.result && <span class="match-card__score">{match.result.away}</span>}
                    <span class="team-name">{match.awayTeam.name}</span>
                    <span class="team-flag">{match.awayTeam.fifaCode}</span>
                  </div>
                </div>
                <div class="match-card__footer">
                  <div class="match-card__meta">
                    <span class="match-date">
                      {formatDate(match.date, locale)} • {formatTime(match.date, locale)}
                    </span>
                    {match.stadium && <span class="match-card__stadium">{match.stadium}</span>}
                  </div>
                  {match.status !== 'scheduled' && (
                    <span class={`badge badge--${statusVariant(match.status)} badge--sm`}>
                      {statusLabel(match.status, translations)}
                    </span>
                  )}
                </div>
              </div>
            ))
          ) : (
            <p class="match-list__empty">
              {locale === 'en' ? 'No upcoming matches' : 'No hay partidos próximos'}
            </p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-template__content {
    flex: 1;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
    width: 100%;
  }

  .home-template__hero {
    text-align: center;
    padding: var(--space-4) var(--space-2);
    margin: var(--space-4) 0;
    background: linear-gradient(135deg, var(--color-primary-400), var(--color-accent-500));
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .home-template__hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-secondary-500),
      var(--color-vibrant-500),
      var(--color-warm-500),
      var(--color-gold-500)
    );
  }

  .home-template__hero-title {
    margin-bottom: var(--space-2);
    font-size: var(--heading-xs);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .home-template__hero p {
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .home-template__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
  }

  .home-template__matches {
    margin: var(--space-6) 0;
  }

  .home-template__matches h3 {
    margin-bottom: var(--space-3);
  }

  .btn {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border: var(--border-pixel-sm) solid var(--border-color);
    text-decoration: none;
    display: inline-block;
    text-align: center;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border-color: var(--color-accent-700);
  }

  .btn--primary:hover {
    background: var(--color-accent-600);
  }

  .btn--secondary {
    background: var(--bg-input);
    color: var(--text-secondary);
  }

  .btn--secondary:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .btn--lg {
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
  }

  .match-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .match-list__empty {
    text-align: center;
    color: var(--text-secondary);
    padding: var(--space-6);
  }

  .match-card {
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    max-width: 100%;
    position: relative;
  }

  .match-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-secondary-500), var(--color-vibrant-500));
  }

  .match-card__teams {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .match-card__team {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
    width: 100%;
    justify-content: center;
  }

  .match-card__team--away {
    flex-direction: row-reverse;
  }

  .match-card__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: var(--bg-input);
    border: var(--border-width-sm) solid var(--border-color);
    flex-shrink: 0;
    order: 1;
    margin: var(--space-1) 0;
  }

  .vs-text {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .match-card__score {
    font-size: var(--text-xl);
    color: var(--color-accent-500);
    min-width: 2ch;
    text-align: center;
    flex-shrink: 0;
  }

  .match-card__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-pixel-sm);
    flex-wrap: wrap;
  }

  .match-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    width: 100%;
    justify-content: space-between;
    font-size: var(--text-xs);
  }

  .match-card__stadium {
    color: var(--text-muted);
    text-align: center;
    font-size: var(--text-xs);
  }

  .badge {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }

  .badge--sm {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
  }

  .badge--info {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
  }
  .badge--warning {
    background: var(--color-warning-100);
    color: var(--color-warning-700);
  }
  .badge--success {
    background: var(--color-success-100);
    color: var(--color-success-700);
  }
  .badge--error {
    background: var(--color-error-100);
    color: var(--color-error-700);
  }
  .badge--accent {
    background: var(--color-accent-100);
    color: var(--color-accent-700);
  }

  .team-flag {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    background: var(--bg-input);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }

  .team-name {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
  }

  .match-date {
    font-size: var(--text-xs);
  }

  @media (min-width: 480px) {
    .home-template__content {
      padding: var(--space-3) var(--space-3);
    }

    .home-template__hero {
      padding: var(--space-6) var(--space-3);
      margin: var(--space-4) 0;
    }

    .home-template__hero-title {
      font-size: var(--heading-sm);
    }
  }

  @media (min-width: 1024px) {
    .home-template__content {
      padding: var(--space-4) var(--space-4);
    }

    .home-template__hero {
      padding: var(--space-8) var(--space-4);
      margin: var(--space-6) 0;
    }

    .home-template__hero-title {
      font-size: var(--heading-md);
    }

    .home-template__hero p {
      font-size: var(--text-base);
    }

    .home-template__actions {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
    }

    .match-card {
      padding: var(--space-4);
    }

    .match-card__teams {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .match-card__team {
      width: auto;
      justify-content: flex-start !important;
    }

    .match-card__team--away {
      justify-content: flex-end !important;
    }

    .match-card__vs {
      order: unset;
      margin: 0;
    }

    .match-card__footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .match-card__meta {
      width: auto;
      justify-content: flex-start;
    }
  }
</style>
