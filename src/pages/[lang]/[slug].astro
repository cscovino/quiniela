---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getBuildData, getBuildRankings } from '@lib/build-data';
import { getLocalizedPaths } from '@utils/slug-map';
import { getFlagClass } from '@utils/flagMapping';
import PredictionsPage from '@pages/PredictionsPage.astro';
import AuthPage from '@pages/AuthPage.astro';
import { ProfileTemplate } from '@templates/ProfileTemplate/ProfileTemplate';
import es from '@locales/es/common.json';
import en from '@locales/en/common.json';
import esAuth from '@locales/es/auth.json';
import enAuth from '@locales/en/auth.json';

export function getStaticPaths() {
  return getLocalizedPaths();
}

const { locale, page, activeNav } = Astro.props;
const translations = locale === 'en' ? en : es;
const authTranslations = locale === 'en' ? enAuth : esAuth;
const isEs = locale === 'es';

const buildData = await getBuildData();
const standings = buildData.standings;
const rankings = await getBuildRankings();

const profileTranslations = {
  title: isEs ? 'Mi Perfil' : 'My Profile',
  loading: isEs ? 'Cargando perfil...' : 'Loading profile...',
  loginRequired: isEs
    ? 'Necesitas iniciar sesión para ver tu perfil'
    : 'You need to login to view your profile',
  loginButton: isEs ? 'Iniciar Sesión' : 'Login',
  totalPoints: isEs ? 'Puntos Totales' : 'Total Points',
  accuracy: isEs ? 'Precisión' : 'Accuracy',
  currentStreak: isEs ? 'Racha Actual' : 'Current Streak',
  bestStreak: isEs ? 'Mejor Racha' : 'Best Streak',
  exactBets: isEs ? 'Apuestas Exactas' : 'Exact Bets',
  rank: isEs ? 'Posición' : 'Rank',
  badges: isEs ? 'Insignias' : 'Badges',
  lockedBadges: isEs ? 'Bloqueadas' : 'Locked',
  pointsChart: isEs ? 'Evolución de Puntos' : 'Points Evolution',
  noPointsData: isEs ? 'Aún no hay datos de puntos' : 'No points data yet',
  points: isEs ? 'Puntos' : 'Points',
  matches: isEs ? 'Partidos' : 'Matches',
};
---

{
  page === 'predictions' && (
    <BaseLayout
      locale={locale}
      title={translations.pages.predictions.title}
      description={translations.pages.predictions.description}
      activeNav={activeNav}
    >
      <PredictionsPage locale={locale} />
    </BaseLayout>
  )
}

{
  page === 'profile' && (
    <BaseLayout
      locale={locale}
      title={translations.pages.profile.title}
      description={translations.pages.profile.description}
      activeNav={activeNav}
    >
      <ProfileTemplate translations={profileTranslations} locale={locale} client:idle />
    </BaseLayout>
  )
}

{
  page === 'login' && (
    <BaseLayout
      locale={locale}
      title={authTranslations.auth.login.title}
      description={authTranslations.auth.login.subtitle}
    >
      <AuthPage locale={locale} initialMode="login" />
    </BaseLayout>
  )
}

{
  page === 'register' && (
    <BaseLayout
      locale={locale}
      title={authTranslations.auth.register.title}
      description={authTranslations.auth.register.subtitle}
    >
      <AuthPage locale={locale} initialMode="register" />
    </BaseLayout>
  )
}

{
  page === 'tournament' && (
    <BaseLayout
      locale={locale}
      title={
        translations.pages.tournament?.title ||
        (isEs ? 'Torneo - Quiniela' : 'Tournament - Quiniela')
      }
      description={
        translations.pages.tournament?.description ||
        (isEs
          ? 'Clasificación de grupos y partidos del torneo'
          : 'Group standings and tournament matches')
      }
      activeNav={activeNav}
    >
      <main class="tournament-template__content">
        <header class="tournament-template__header">
          <h1>{isEs ? 'Torneo' : 'Tournament'}</h1>
        </header>

        <div class="tournament-template__tabs" role="tablist">
          <button
            class="tournament-template__tab active"
            data-tab="standings"
            role="tab"
            aria-selected="true"
          >
            {isEs ? 'Clasificación' : 'Standings'}
          </button>
          <button
            class="tournament-template__tab"
            data-tab="matches"
            role="tab"
            aria-selected="false"
          >
            {isEs ? 'Partidos' : 'Matches'}
          </button>
        </div>

        <section class="tournament-template__standings" data-panel="standings">
          <h2>{isEs ? 'Fase de Grupos' : 'Group Stage'}</h2>
          {standings.length > 0 ? (
            standings.map((group) => (
              <div class="group-standings">
                <h3 class="group-standings__name">{group.name}</h3>
                <table class="group-standings__table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>{isEs ? 'Equipo' : 'Team'}</th>
                      <th>P</th>
                      <th>{isEs ? 'G' : 'W'}</th>
                      <th>{isEs ? 'E' : 'D'}</th>
                      <th>{isEs ? 'P' : 'L'}</th>
                      <th>GF</th>
                      <th>GC</th>
                      <th>Pts</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.standings.map((s) => (
                      <tr>
                        <td>{s.position}</td>
                        <td class="group-standings__team">
                          <span
                            class={`flag-icon ${getFlagClass(s.fifaCode)}`}
                            role="img"
                            aria-label={`${s.fifaCode} flag`}
                          />
                          <span>{s.fifaCode}</span>
                        </td>
                        <td>{s.played}</td>
                        <td>{s.won}</td>
                        <td>{s.drawn}</td>
                        <td>{s.lost}</td>
                        <td>{s.goalsFor}</td>
                        <td>{s.goalsAgainst}</td>
                        <td class="group-standings__pts">{s.points}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))
          ) : (
            <p class="tournament-template__empty">
              {isEs ? 'No hay clasificación disponible' : 'No standings available'}
            </p>
          )}
        </section>

        <section class="tournament-template__matches" data-panel="matches" hidden>
          <h3>{isEs ? 'Todos los Partidos' : 'All Matches'}</h3>
          <div id="matches-container" class="match-list">
            {buildData.matches.length > 0 ? (
              buildData.matches.map((match) => (
                <div class="match-card">
                  <div class="match-card__teams">
                    <div class="match-card__team match-card__team--home">
                      <span
                        class={`flag-icon ${getFlagClass(match.homeTeam.fifaCode)}`}
                        role="img"
                        aria-label={`${match.homeTeam.name} flag`}
                      />
                      <span class="team-code">{match.homeTeam.fifaCode}</span>
                      <span class="team-name">{match.homeTeam.name}</span>
                      {match.result && <span class="match-card__score">{match.result.home}</span>}
                    </div>
                    <div class="match-card__vs">
                      <span class="vs-text">VS</span>
                    </div>
                    <div class="match-card__team match-card__team--away">
                      {match.result && <span class="match-card__score">{match.result.away}</span>}
                      <span class="team-name">{match.awayTeam.name}</span>
                      <span class="team-code">{match.awayTeam.fifaCode}</span>
                      <span
                        class={`flag-icon ${getFlagClass(match.awayTeam.fifaCode)}`}
                        role="img"
                        aria-label={`${match.awayTeam.name} flag`}
                      />
                    </div>
                  </div>
                  <div class="match-card__footer">
                    <div class="match-card__meta">
                      <span class="match-date">
                        {match.date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-ES', {
                          month: 'short',
                          day: 'numeric',
                          year: 'numeric',
                        })}{' '}
                        •{' '}
                        {match.date.toLocaleTimeString(locale === 'en' ? 'en-US' : 'es-ES', {
                          hour: '2-digit',
                          minute: '2-digit',
                        })}
                      </span>
                    </div>
                    {match.status !== 'scheduled' && (
                      <span
                        class={`badge badge--${match.status === 'finished' ? 'success' : match.status === 'live' ? 'warning' : 'info'} badge--sm`}
                      >
                        {match.status}
                      </span>
                    )}
                  </div>
                </div>
              ))
            ) : (
              <p class="match-list__empty">
                {isEs ? 'No hay partidos disponibles' : 'No matches available'}
              </p>
            )}
          </div>
        </section>
      </main>
    </BaseLayout>
  )
}

{
  page === 'rankings' && (
    <BaseLayout
      locale={locale}
      title={translations.pages.rankings.title}
      description={translations.pages.rankings.description}
      activeNav={activeNav}
    >
      <main class="rankings-template__content">
        <header class="rankings-template__header">
          <h1>{isEs ? 'Clasificación de Pronosticadores' : 'Predictor Rankings'}</h1>
        </header>

        {rankings.length > 0 ? (
          <table class="rankings-table">
            <thead>
              <tr>
                <th>#</th>
                <th>{isEs ? 'Jugador' : 'Player'}</th>
                <th>Pts</th>
                <th>{isEs ? 'Precisión' : 'Accuracy'}</th>
                <th>{isEs ? 'Racha' : 'Streak'}</th>
              </tr>
            </thead>
            <tbody>
              {rankings.map((r, i) => (
                <tr>
                  <td class="rankings-table__rank">{i + 1}</td>
                  <td class="rankings-table__name">{r.displayName}</td>
                  <td class="rankings-table__points">{r.points}</td>
                  <td>{r.accuracy}%</td>
                  <td>{r.streak}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="rankings-template__empty">
            {isEs
              ? '¡Aún no hay clasificación. ¡Haz predicciones para aparecer aquí!'
              : 'No rankings available yet. Make predictions to appear here!'}
          </p>
        )}
      </main>
    </BaseLayout>
  )
}

<style>
  .tournament-template__content,
  .rankings-template__content {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2);
  }

  .tournament-template__header,
  .rankings-template__header {
    margin-bottom: var(--space-4);
  }

  .tournament-template__header h1,
  .rankings-template__header h1 {
    font-family: var(--font-pixel);
    font-size: var(--heading-sm);
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-warm-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tournament-template__tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tournament-template__tab {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-input);
    border: var(--border-pixel-sm) solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .tournament-template__tab.active {
    background: var(--color-accent-500);
    color: var(--text-inverse);
    border-color: var(--color-accent-700);
  }

  .tournament-template__standings h2 {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .group-standings {
    margin-bottom: var(--space-4);
  }
  .group-standings__name {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
  }

  .group-standings__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
  }

  .group-standings__table th,
  .group-standings__table td {
    padding: var(--space-2);
    text-align: center;
    border-bottom: var(--border-pixel-sm);
  }

  .group-standings__table th {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-input);
  }

  .group-standings__team {
    font-family: var(--font-pixel);
    text-align: left !important;
  }
  .group-standings__pts {
    font-weight: bold;
    color: var(--color-accent-500);
  }

  .tournament-template__empty,
  .rankings-template__empty,
  .match-list__empty {
    text-align: center;
    color: var(--text-secondary);
    padding: var(--space-6);
  }

  .match-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .match-card {
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
  }

  .match-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-secondary-500), var(--color-vibrant-500));
  }

  .match-card__teams {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .match-card__team {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
    width: 100%;
    justify-content: center;
  }
  .match-card__team--away {
    flex-direction: row-reverse;
  }

  .match-card__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: var(--bg-input);
    border: var(--border-width-sm) solid var(--border-color);
    order: 1;
    margin: var(--space-1) 0;
  }

  .vs-text {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .match-card__score {
    font-size: var(--text-xl);
    color: var(--color-accent-500);
    min-width: 2ch;
    text-align: center;
  }

  .match-card__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-pixel-sm);
    flex-wrap: wrap;
  }

  .match-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    width: 100%;
    justify-content: space-between;
    font-size: var(--text-xs);
  }
  .match-card__stadium {
    color: var(--text-muted);
    text-align: center;
    font-size: var(--text-xs);
  }

  .badge {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }
  .badge--sm {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
  }
  .badge--info {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
  }
  .badge--warning {
    background: var(--color-warning-100);
    color: var(--color-warning-700);
  }
  .badge--success {
    background: var(--color-success-100);
    color: var(--color-success-700);
  }

  .flag-icon {
    width: 32px;
    height: 24px;
    flex-shrink: 0;
    border: var(--border-pixel-sm);
    display: inline-block;
  }
  .group-standings__team .flag-icon {
    width: 24px;
    height: 18px;
    margin-right: var(--space-2);
    vertical-align: middle;
  }
  .group-standings__team {
    text-align: left !important;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
  }
  .team-code {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    background: var(--bg-input);
    padding: var(--space-1) var(--space-2);
    border: var(--border-pixel-sm);
  }
  .team-name {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
  }

  .rankings-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border: var(--border-pixel-md);
    box-shadow: var(--shadow-md);
  }

  .rankings-table th,
  .rankings-table td {
    padding: var(--space-2) var(--space-3);
    text-align: center;
    border-bottom: var(--border-pixel-sm);
  }

  .rankings-table th {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-input);
  }

  .rankings-table__rank {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--color-accent-500);
  }
  .rankings-table__name {
    font-family: var(--font-pixel);
    text-align: left !important;
  }
  .rankings-table__points {
    font-weight: bold;
    color: var(--color-gold-500);
  }

  @media (min-width: 1024px) {
    .tournament-template__content,
    .rankings-template__content {
      padding: var(--space-4) var(--space-4);
    }
    .tournament-template__header h1,
    .rankings-template__header h1 {
      font-size: var(--heading-md);
    }
    .match-card {
      padding: var(--space-4);
    }
    .match-card__teams {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }
    .match-card__team {
      width: auto;
      justify-content: flex-start !important;
    }
    .match-card__team--away {
      justify-content: flex-end !important;
    }
    .match-card__vs {
      order: unset;
      margin: 0;
    }
    .match-card__footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .match-card__meta {
      width: auto;
      justify-content: flex-start;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    var tabs = document.querySelectorAll('.tournament-template__tab');
    var panels = document.querySelectorAll('[data-panel]');
    if (tabs.length === 0) return;
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        panels.forEach(function (p) {
          p.hidden = p.getAttribute('data-panel') !== target;
        });
      });
    });
  });
</script>
