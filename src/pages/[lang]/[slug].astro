---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLocalizedPaths } from '@utils/slug-map';
import PredictionsPage from '@pages/PredictionsPage.astro';
import AuthPage from '@pages/AuthPage.astro';
import ProfilePage from '@pages/ProfilePage.astro';
import TournamentPage from '@pages/TournamentPage.astro';
import RankingsPage from '@pages/RankingsPage.astro';
import es from '@locales/es/common.json';
import en from '@locales/en/common.json';
import esAuth from '@locales/es/auth.json';
import enAuth from '@locales/en/auth.json';

export function getStaticPaths() {
  return getLocalizedPaths();
}

const { locale, page, activeNav } = Astro.props;
const t = locale === 'en' ? en : es;
const tAuth = locale === 'en' ? enAuth : esAuth;
const isEs = locale === 'es';
---

{
  page === 'predictions' && (
    <BaseLayout
      locale={locale}
      title={t.pages.predictions.title}
      description={t.pages.predictions.description}
      activeNav={activeNav}
    >
      <PredictionsPage locale={locale} />
    </BaseLayout>
  )
}

{
  page === 'profile' && (
    <BaseLayout
      locale={locale}
      title={t.pages.profile.title}
      description={t.pages.profile.description}
      activeNav={activeNav}
    >
      <ProfilePage locale={locale} />
    </BaseLayout>
  )
}

{
  page === 'login' && (
    <BaseLayout
      locale={locale}
      title={tAuth.auth.login.title}
      description={tAuth.auth.login.subtitle}
    >
      <AuthPage locale={locale} initialMode="login" />
    </BaseLayout>
  )
}

{
  page === 'register' && (
    <BaseLayout
      locale={locale}
      title={tAuth.auth.register.title}
      description={tAuth.auth.register.subtitle}
    >
      <AuthPage locale={locale} initialMode="register" />
    </BaseLayout>
  )
}

{
  page === 'tournament' && (
    <BaseLayout
      locale={locale}
      title={t.pages.tournament?.title || (isEs ? 'Torneo - Quiniela' : 'Tournament - Quiniela')}
      description={
        t.pages.tournament?.description ||
        (isEs
          ? 'Clasificación de grupos y partidos del torneo'
          : 'Group standings and tournament matches')
      }
      activeNav={activeNav}
    >
      <TournamentPage locale={locale} />
    </BaseLayout>
  )
}

{
  page === 'rankings' && (
    <BaseLayout
      locale={locale}
      title={t.pages.rankings.title}
      description={t.pages.rankings.description}
      activeNav={activeNav}
    >
      <RankingsPage locale={locale} />
    </BaseLayout>
  )
}
