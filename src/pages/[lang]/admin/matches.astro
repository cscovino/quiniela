---
import BaseLayout from '@layouts/BaseLayout.astro';
import { AdminMatchesPage } from '@organisms/AdminMatchesPage/AdminMatchesPage';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' }, props: { locale: 'es' } },
    { params: { lang: 'en' }, props: { locale: 'en' } },
  ];
}

const { locale } = Astro.props;
const title = locale === 'en' ? 'Admin - Manage Matches' : 'Admin - Gestionar Partidos';
const description =
  locale === 'en'
    ? 'Update match results and manage tournament data'
    : 'Actualizar resultados y gestionar datos del torneo';
---

<BaseLayout locale={locale} title={title} description={description} activeNav="admin">
  <AdminMatchesPage client:idle />
</BaseLayout>
