---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProfilePage from '@pages/ProfilePage.astro';
import es from '@locales/es/common.json';

const locale = 'es';
const translations = es;
---

<BaseLayout
  locale={locale}
  title={translations.pages.profile.title}
  description={translations.pages.profile.description}
  activeNav="profile"
>
  <ProfilePage locale={locale} />
</BaseLayout>
