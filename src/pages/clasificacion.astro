---
import BaseLayout from '@layouts/BaseLayout.astro';
import { RankingsTemplate } from '@templates/RankingsTemplate/RankingsTemplate';
import es from '@locales/es/common.json';

const locale = 'es';
const translations = es;

const templateProps = {
  translations: {
    title: 'Clasificación de Pronosticadores',
    noRankings: '¡Aún no hay clasificación. ¡Haz predicciones para aparecer aquí!',
    loading: 'Cargando clasificación...',
  },
  locale,
};
---

<BaseLayout
  locale={locale}
  title={translations.pages.rankings.title}
  description={translations.pages.rankings.description}
  activeNav="rankings"
>
  <RankingsTemplate {...templateProps} client:idle />
</BaseLayout>
