---
import BaseLayout from '@layouts/BaseLayout.astro';
import StandingsPage from '@pages/StandingsPage.astro';
import es from '@locales/es/common.json';

const locale = 'es';
const translations = es;
---

<BaseLayout
  locale={locale}
  title={translations.pages.standings.title}
  description={translations.pages.standings.description}
  activeNav="standings"
>
  <StandingsPage locale={locale} />
</BaseLayout>
