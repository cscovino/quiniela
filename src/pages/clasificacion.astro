        won: 1,
        drawn: 0,
        lost: 1,
        goalsFor: 3,
        goalsAgainst: 2,
        points: 3,
      },
      {
        teamId: 'jpn',
        teamName: 'Japon',
        fifaCode: 'JPN',
        position: 3,
        played: 2,
        won: 0,
